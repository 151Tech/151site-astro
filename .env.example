# Storyblok Content Delivery API token (Settings > Access Tokens > Preview or
# Public token). Used at runtime by src/lib/storyblok.ts to fetch content.
STORYBLOK_TOKEN=

# Storyblok space ID (Settings > General). Used both at runtime and by the
# one-off migration script below.
STORYBLOK_SPACE_ID=

# Storyblok Management API OAuth token (My Account > Personal Access Tokens).
# ONLY needed to run `npm run storyblok:migrate` - it can create/overwrite
# content in the space, so keep it out of any deploy environment; it's not
# read by the site itself at runtime.
STORYBLOK_OAUTH_TOKEN=

# Set to "true" ONLY on the preview deployment (the `preview` branch's own
# Webflow Cloud app). It switches content reads from the committed build-time
# snapshot to the live Storyblok API in draft mode, and turns off prerendering
# so each request re-fetches - which is what makes the Visual Editor's
# preview pane show unpublished edits. Never set this on production.
STORYBLOK_DRAFT_MODE=false

# --- Contact forms (src/pages/api/contact.ts, via Resend) ---

# Resend API key. REQUIRED for either website form to send; without it the
# endpoint answers 500 and the visitor sees an error. Set this in the Webflow
# Cloud environment-variable dashboard for production, not just here.
RESEND_API_KEY=

# Address the mail is sent FROM. The display name is always "151 Coffee Website
# Contact"; this is only the address half. Leave blank to fall back to Resend's
# sandbox sender (onboarding@resend.dev), which delivers ONLY to the Resend
# account owner - fine for a smoke test, not for production. Once 151coffee.com
# is verified in Resend (DNS records at the registrar), set something like
# website@151coffee.com here.
RESEND_FROM_ADDRESS=

# Where each form's submissions land. Both default to tech@151coffee.com.
RESEND_TO_CONTACT=
RESEND_TO_REALESTATE=

# Extra hostname allowed to POST to /api/contact, on top of 151coffee.com,
# www.151coffee.com, localhost, and the preview app's own
# *.webflow.io host. Only needed if the site is ever served from another
# domain.
EXTRA_ALLOWED_ORIGIN_HOST=

# Set to "true" to switch off the preview-site access gate (src/lib/
# preview-gate.ts). Break-glass only: the preview app becomes reachable by
# anyone with the URL.
PREVIEW_GATE_DISABLED=false

# --- Investor waitlist (src/pages/api/contact.ts, via Google Sheets) ---
# Mirrors how the old Wix site handled this form: submissions land in a
# spreadsheet, nobody gets emailed. Needs a Google Cloud service account with
# Sheets API access, and that service account's email shared as an Editor on
# the target spreadsheet (Share button in Google Sheets, same as sharing with
# a person).

# Service account's client_email, from the JSON key file Google Cloud Console
# gives you when you create the service account + key
# (IAM & Admin > Service Accounts > Keys > Add Key > JSON).
GOOGLE_SHEETS_CLIENT_EMAIL=

# Service account's private_key from that same JSON key file. Paste it with
# literal \n escapes in place of real newlines if the dashboard you're
# setting this in collapses multi-line values - src/lib/google-sheets.ts
# normalizes either form.
GOOGLE_SHEETS_PRIVATE_KEY=

# The spreadsheet's ID, from its URL:
# https://docs.google.com/spreadsheets/d/THIS_PART/edit
# The sheet (tab) written to is named "Waitlist" - create one with that name,
# or change the `range` passed to appendRow() in contact.ts to match yours.
GOOGLE_SHEETS_INVEST_SPREADSHEET_ID=

# --- Instagram carousel (src/lib/instagram.ts) ---
# See storyblok/instagram-setup.md for the one-time setup these require.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# Shared secret for the one-time OAuth callback (src/pages/api/
# instagram-oauth-callback.ts). Make up any random string; it goes in the
# `state=` param of the authorize URL in storyblok/instagram-setup.md and is
# what stops a stranger from hitting the callback directly to hijack the
# stored token.
INSTAGRAM_OAUTH_STATE=

# The exact redirect_uri registered in the Meta app, e.g.
# https://www.151coffee.com/api/instagram-oauth-callback - it must match the
# authorize URL's redirect_uri byte for byte or Instagram refuses to exchange
# the code. Only needed because Webflow Cloud's proxy makes the Host header
# unreliable, so the callback can't safely derive its own public URL (same
# reason astro.config.mjs sets security.checkOrigin: false). Leave blank for
# local dev, where deriving it from the request works fine.
INSTAGRAM_REDIRECT_URI=

# Shared secret for the scheduled token-refresh endpoint (src/pages/api/
# instagram-token-refresh.ts). Different from INSTAGRAM_OAUTH_STATE above -
# this one is sent as a header by the GitHub Actions workflow, not a `state`
# param on an OAuth redirect. Make up another random string.
INSTAGRAM_REFRESH_SECRET=

# --- Cookie-gated tracking (public/js/analytics-loader.js) ---
# Both are PUBLIC_-prefixed on purpose: Astro exposes anything with that
# prefix to client-side code, which is fine here since a GA measurement ID
# and a Meta Pixel ID are meant to appear in every page's HTML anyway -
# neither is a secret the way RESEND_API_KEY or STORYBLOK_TOKEN are. Leave
# either blank to skip that vendor entirely; analytics-loader.js only loads
# a vendor whose ID is set, and only after the visitor clicks "Accept All"
# on the cookie banner.

# Google Analytics 4 Measurement ID, e.g. G-XXXXXXXXXX (GA4 admin > Data
# Streams > your web stream).
PUBLIC_GA_MEASUREMENT_ID=

# Meta/Facebook Pixel ID (Meta Events Manager > Data Sources > your pixel).
PUBLIC_META_PIXEL_ID=
