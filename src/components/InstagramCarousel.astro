---
// The 3 most recent @151coffee Instagram posts/reels, shown as a 3-card
// "coverflow": the newest sits larger in the center, the 2nd newest smaller
// on the right, the 3rd smaller on the left. `media` is fetched server-side
// via the Instagram Graph API (see src/lib/instagram.ts) and passed in as a
// prop rather than fetched here, so this component stays a pure renderer --
// easy to preview with fake data without needing live credentials.
//
// These render as self-hosted <video> cards (not a live Instagram embed):
// Instagram's oEmbed widget can't be styled/controlled enough to fit this
// layout, and only exposes a single post at a time rather than a feed. A
// muted, looping local video that links out to the real post sidesteps that.
// `videoUrl` is optional -- the real Graph API integration (src/lib/
// instagram.ts) only ever returns a still cover image, so that path still
// renders a plain <img>; only the temporary hardcoded fallback in
// src/pages/index.astro currently sets `videoUrl`. What still rotates is
// which slide sits in which slot, on a fixed timer (ROTATE_INTERVAL_MS
// below) -- purely a visual "now featured" cue, independent of each video's
// own (unsynced, looping) playback.
interface Media {
  id: string;
  permalink: string;
  mediaUrl: string;
  videoUrl?: string;
  caption: string;
}

interface Props {
  media: Media[] | null;
  heading?: string;
  social?: { tiktok?: string; instagram?: string; facebook?: string };
}

const { media, heading = 'Fresh Off Our Feed', social } = Astro.props;
const socialLinks = {
  tiktok: social?.tiktok || 'https://www.tiktok.com/@151coffee',
  instagram: social?.instagram || 'https://www.instagram.com/151coffee',
  facebook: social?.facebook || '#',
};

// null means the integration isn't connected yet (no KV/credentials) or the
// Instagram call failed -- either way, the section just doesn't render
// rather than showing a broken or empty carousel.
const items = (media ?? []).slice(0, 3);
---

{items.length > 0 && (
<section class="ig-feed" id="instagram">
  <div class="container">
    <div class="section-header">
      <div class="ig-social-links">
        <a href={socialLinks.tiktok} target="_blank" rel="noopener noreferrer" aria-label="151 Coffee on TikTok">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.6 5.82c-.8-.85-1.24-1.96-1.24-3.14h-3.06v13.44c0 1.53-1.24 2.77-2.77 2.77a2.77 2.77 0 0 1 0-5.54c.28 0 .55.04.8.12v-3.1a5.87 5.87 0 0 0-.8-.06 5.83 5.83 0 1 0 5.83 5.83V9.4a7.16 7.16 0 0 0 4.24 1.37V7.7a4.15 4.15 0 0 1-3-1.88z"/></svg>
        </a>
        <a href={socialLinks.instagram} target="_blank" rel="noopener noreferrer" aria-label="151 Coffee on Instagram">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
        </a>
        <a href={socialLinks.facebook} target="_blank" rel="noopener noreferrer" aria-label="151 Coffee on Facebook">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7.6h2.55l.38-2.96h-2.93V8.55c0-.86.24-1.44 1.47-1.44h1.57V4.46A21 21 0 0 0 14.3 4.3c-2.24 0-3.78 1.37-3.78 3.87v2.16H7.95v2.96h2.57V21h3z"/></svg>
        </a>
      </div>
      <h2>{heading}</h2>
    </div>
    <div class="ig-stage" data-ig-stage>
      {items.map((m, i) => (
        <div class="ig-slide" data-index={i}>
          <div class="ig-now-playing">
            <span class="ig-now-dot"></span>
            Now Playing
            <span class="ig-progress"><i></i></span>
          </div>
          <a class="ig-card-placeholder" href={m.permalink} target="_blank" rel="noopener noreferrer" aria-label={m.caption || 'View on Instagram'}>
            {m.videoUrl ? (
              <video src={m.videoUrl} poster={m.mediaUrl || undefined} muted playsinline preload="metadata" />
            ) : (
              <>
                {m.mediaUrl && <img src={m.mediaUrl} alt="" loading="lazy" />}
                <span class="ig-play">&#9658;</span>
              </>
            )}
          </a>
          {m.videoUrl && (
            <button type="button" class="ig-mute-btn" data-mute-btn aria-label="Unmute" aria-pressed="false">
              <svg class="ig-icon-muted" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4 9v6h4l5 5V4L8 9H4zm11.5 3a4.5 4.5 0 0 0-2.5-4.03v8.06A4.5 4.5 0 0 0 15.5 12z"/><path d="M18.5 4.5 4.5 18.5l-1-1L17.5 3.5z"/></svg>
              <svg class="ig-icon-unmuted" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4 9v6h4l5 5V4L8 9H4zm11.5 3a4.5 4.5 0 0 0-2.5-4.03v8.06A4.5 4.5 0 0 0 15.5 12zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/></svg>
            </button>
          )}
        </div>
      ))}
    </div>
    <a class="ig-cta" href={socialLinks.instagram} target="_blank" rel="noopener noreferrer">
      New drinks, weird dance moves, and probably too much caffeine. Come hang with us on Instagram.
    </a>
  </div>
</section>
)}

<script>
  // Rotates which of the (up to) 3 slides sits in the left/center/right slot.
  // Only the center slide ever plays (and only it is ever unmuted; side
  // slides are always paused and muted). Rather than playing each source
  // video to the end -- these are full-length TikTok/Reel clips, often
  // 30s+ -- the center slide advances after a short CLIP_PREVIEW_MS preview
  // instead, so the carousel keeps a brisk, consistent pace regardless of
  // how long the underlying video actually is. A slide with no video (the
  // still-image Graph API path) has nothing to preview, so it keeps the
  // longer PLAYBACK_FALLBACK_MS timer instead. A video shorter than the
  // preview window can still end naturally first (wired further below) --
  // either path calls the same rotate().
  //
  // Direction matches the requested motion: the right slide moves to center,
  // the center slide moves to left, and the left slide moves to right
  // (wrapping around) -- a fixed rotation among exactly 3 positions, so with
  // 3 items it cycles back to the starting arrangement every 3rd tick.
  //
  // The left->right leg is the odd one out: instead of just sliding straight
  // across while staying visible, it fully exits (further left, fading to
  // invisible -- see .slot-exit in style.css), then gets snapped to the
  // mirror-image invisible spot on the right (.slot-enter-prep, no
  // transition) and finally animates into the normal dimmed right slot. The
  // other two legs (center->left, right->center) just swap classes directly
  // since both endpoints are visible the whole time.
  const CLIP_PREVIEW_MS = 5000; // how much of each video plays before advancing
  const PLAYBACK_FALLBACK_MS = 8000; // only used for slides with no video to end on
  const EXIT_MS = 700; // matches the .ig-slide transition duration in style.css
  const SLOT_CLASSES = ['slot-left', 'slot-center', 'slot-right'];

  function getVideo(slide: HTMLElement) {
    return slide.querySelector<HTMLVideoElement>('video');
  }

  function getMuteBtn(slide: HTMLElement) {
    return slide.querySelector<HTMLButtonElement>('[data-mute-btn]');
  }

  function getProgressBar(slide: HTMLElement) {
    return slide.querySelector<HTMLElement>('.ig-progress > i');
  }

  function setBarWidth(slide: HTMLElement, pct: number) {
    const bar = getProgressBar(slide);
    if (bar) bar.style.width = `${Math.max(0, Math.min(100, pct))}%`;
  }

  // Only the slide currently in the center slot ever plays. Every other
  // slide -- including one mid-exit -- gets paused and rewound, and its mute
  // button (if any) reset, so a video never keeps running in the background
  // slot or bleeds audio from a stale unmute.
  function pauseSlide(slide: HTMLElement) {
    const video = getVideo(slide);
    if (video) {
      video.pause();
      video.currentTime = 0;
      video.muted = true;
    }
    const btn = getMuteBtn(slide);
    if (btn) {
      btn.classList.remove('is-unmuted');
      btn.setAttribute('aria-label', 'Unmute');
      btn.setAttribute('aria-pressed', 'false');
    }
    setBarWidth(slide, 0);
  }

  // Always (re)starts center playback muted -- autoplay-with-sound is
  // blocked by every major browser regardless of user gesture history, and
  // resetting to muted on every rotation keeps that guarantee instead of
  // depending on whichever mute state the video happened to be left in.
  function playCenter(slide: HTMLElement) {
    const video = getVideo(slide);
    if (!video) return;
    video.currentTime = 0;
    video.muted = true;
    setBarWidth(slide, 0);
    video.play().catch(() => {
      // Autoplay can still be refused (e.g. low-power mode) -- the poster
      // frame stays visible and the fallback timer (wired below) still
      // advances the carousel on schedule either way.
    });
  }

  function initIgStage(stage: Element) {
    const slides = Array.from(stage.querySelectorAll<HTMLElement>('.ig-slide'));

    // Unmuting is a per-slide toggle on whichever video is currently playing;
    // wiring it once at init (rather than re-wiring per rotation) is simpler
    // and the handler already no-ops harmlessly on a paused, backgrounded
    // slide since nothing calls it there.
    slides.forEach((slide) => {
      const video = getVideo(slide);
      const btn = getMuteBtn(slide);
      if (!video || !btn) return;
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        video.muted = !video.muted;
        btn.classList.toggle('is-unmuted', !video.muted);
        btn.setAttribute('aria-label', video.muted ? 'Unmute' : 'Mute');
        btn.setAttribute('aria-pressed', String(!video.muted));
      });
      video.addEventListener('timeupdate', () => {
        if (!slide.classList.contains('is-active') || !video.duration) return;
        setBarWidth(slide, (video.currentTime / video.duration) * 100);
      });
    });

    if (slides.length < 3) {
      // Fewer than 3 items: nothing to rotate, just center whatever exists
      // and let it loop on its own (there's no "next" slide to hand off to).
      slides.forEach((el) => el.classList.add('slot-center', 'slot-static', 'is-active'));
      const only = slides[0];
      if (only) {
        const video = getVideo(only);
        if (video) video.loop = true;
        playCenter(only);
      }
      return;
    }

    // order[0] = index of the item currently in the left slot, etc.
    let order = [2, 0, 1]; // left=3rd-newest, center=newest, right=2nd-newest
    let fallbackTimeoutId: ReturnType<typeof setTimeout> | null = null;

    function clearFallback() {
      if (fallbackTimeoutId !== null) { clearTimeout(fallbackTimeoutId); fallbackTimeoutId = null; }
    }

    function armFallback(centerSlide: HTMLElement) {
      clearFallback();
      // A video slide only ever plays a short preview clip -- advance after
      // CLIP_PREVIEW_MS rather than waiting for the (much longer) source
      // video to actually end. A still-image slide has no video to preview,
      // so it keeps the longer PLAYBACK_FALLBACK_MS instead. Harmless if a
      // short video's own "ended" event fires first -- rotate() below always
      // cancels this timer.
      const delay = getVideo(centerSlide) ? CLIP_PREVIEW_MS : PLAYBACK_FALLBACK_MS;
      fallbackTimeoutId = setTimeout(rotate, delay);
    }

    const applySlots = () => {
      slides.forEach((el, i) => {
        el.classList.remove(...SLOT_CLASSES, 'slot-exit', 'slot-enter-prep', 'is-active');
        const slot = order.indexOf(i);
        el.classList.add(SLOT_CLASSES[slot]);
        if (slot === 1) {
          el.classList.add('is-active');
        } else {
          pauseSlide(el);
        }
      });
    };
    applySlots(); // initial paint: all 3 slides visible at rest
    const initialCenter = slides[order[1]];
    playCenter(initialCenter);
    armFallback(initialCenter);

    function rotate() {
      clearFallback();
      const [leftIdx, centerIdx, rightIdx] = order;
      const leftEl = slides[leftIdx];
      const centerEl = slides[centerIdx];
      const rightEl = slides[rightIdx];

      // center -> left and right -> center: ordinary swaps, both endpoints
      // stay visible throughout so the base .7s transition just crossfades.
      centerEl.classList.remove('slot-center', 'is-active');
      centerEl.classList.add('slot-left');
      pauseSlide(centerEl);

      rightEl.classList.remove('slot-right');
      rightEl.classList.add('slot-center', 'is-active');
      playCenter(rightEl);
      armFallback(rightEl);

      // left -> right: exit fully first, then reappear from the right.
      leftEl.classList.remove('slot-left');
      leftEl.classList.add('slot-exit');
      setTimeout(() => {
        leftEl.classList.remove('slot-exit');
        leftEl.classList.add('slot-enter-prep');
        void leftEl.offsetWidth; // force the instant off-right jump to paint
        requestAnimationFrame(() => {
          leftEl.classList.remove('slot-enter-prep');
          leftEl.classList.add('slot-right');
        });
      }, EXIT_MS);

      order = [centerIdx, rightIdx, leftIdx];
    }

    // A video only advances the carousel while it's actually the one in the
    // center slot -- checking is-active at fire time (rather than relying on
    // element identity) means a stale "ended" from a slide that already got
    // paused/rewound elsewhere can never double-trigger a rotation.
    slides.forEach((slide) => {
      const video = getVideo(slide);
      if (!video) return;
      video.addEventListener('ended', () => {
        if (slide.classList.contains('is-active')) rotate();
      });
    });

    document.addEventListener('visibilitychange', () => {
      const centerSlide = slides[order[1]];
      const video = getVideo(centerSlide);
      if (document.hidden) {
        clearFallback();
        video?.pause();
        return;
      }
      video?.play().catch(() => {});
      armFallback(centerSlide);
    });
  }

  document.querySelectorAll('[data-ig-stage]').forEach(initIgStage);
</script>
