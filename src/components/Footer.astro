---
import { getSettings, unwrapSingletons } from '../lib/storyblok';
import Editable from './Editable.astro';
const s = unwrapSingletons((await getSettings()) as any, ['social', 'footer']);
const f = s.footer ?? {};
const cmsCompanyLinks: { label: string; href: string }[] = f.companyLinks ?? [
  { label: 'About Us', href: '/about' },
  { label: 'Careers', href: '/careers' },
  { label: 'Partnerships', href: '/#contact' },
  { label: 'Privacy Policy', href: '/privacy-policy' },
];

// /loyalty exists to correct third-party misinformation about birthday drinks
// and a "50% off Wednesday" (see src/pages/loyalty.astro), which only works if
// crawlers can actually reach it -- an orphan page with no internal link
// pointing at it gets crawled weakly and carries almost no weight. The footer
// is the right prominence: reachable and indexable, but out of the main nav.
//
// Appended here rather than added to the fallback list above because
// companyLinks is populated in Storyblok, so the fallback never runs in
// production. Deduped by href, so the moment an editor adds the link in
// Storyblok this line stops contributing and can be deleted.
const companyLinks = cmsCompanyLinks.some((l) => l.href === '/loyalty')
  ? cmsCompanyLinks
  : [...cmsCompanyLinks, { label: 'Loyalty Policies', href: '/loyalty' }];
const giftCardUrl = s.giftCardUrl ?? 'https://giftcards-151coffee-orders.crispnow.com';

// Instagram supports a reliable username-based app URI scheme, so a tap can
// open the native app directly instead of the profile's mobile web page.
// (Facebook/TikTok/LinkedIn don't have an equivalent public, username-based
// scheme, so those stay as plain web links.)
const igUsername = (s.social?.instagram ?? '').match(/instagram\.com\/([^/?]+)/)?.[1];
const igAppUrl = igUsername ? `instagram://user?username=${igUsername}` : undefined;
---
<footer>
  <div class="container">
    <div class="footer-content" style="padding:2rem;border:2px solid var(--red);border-radius:24px;">
      <Editable blok={f} />
      <div class="footer-section">
        <h4>{f.companyHeading ?? 'Company'}</h4>
        <ul>
          {companyLinks.map((link, i) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>
      <div class="footer-social-section">
        <h4>{f.socialHeading ?? 'Social'}</h4>
        <ul>
          <li><a href={s.social?.tiktok ?? '#'} target="_blank" rel="noopener noreferrer">TikTok</a></li>
          <li><a href={s.social?.facebook ?? '#'} target="_blank" rel="noopener noreferrer">Facebook</a></li>
          <li><a href={s.social?.instagram ?? '#'} data-app-url={igAppUrl} target="_blank" rel="noopener noreferrer">Instagram</a></li>
          <li><a href={s.social?.linkedin ?? '#'} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
        </ul>
      </div>
      <div class="footer-section">
        <h4>{f.supportHeading ?? 'Support'}</h4>
        <ul>
          <li><a href={`mailto:${s.email ?? 'Contact@151Coffee.com'}`}>{f.contactLabel ?? 'Contact'}</a></li>
          <li><a href={`tel:${(s.phone ?? '').replace(/\D/g,'')}`}>{f.callLabel ?? 'Call Us'}</a></li>
          <li><a href={`mailto:${s.email ?? 'Contact@151Coffee.com'}`}>{f.supportLabel ?? 'Support'}</a></li>
          <li><button type="button" id="giftCardFooterSupportBtn">{f.giftCardCheckLabel ?? 'Check Gift Card'}</button></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <div class="social-links">
        <a href={s.social?.facebook ?? '#'} target="_blank" rel="noopener noreferrer" aria-label="Facebook">f</a>
        <a href={s.social?.tiktok ?? '#'} target="_blank" rel="noopener noreferrer" aria-label="TikTok">tt</a>
        <a href={s.social?.linkedin ?? '#'} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">in</a>
        <a href={s.social?.instagram ?? '#'} data-app-url={igAppUrl} target="_blank" rel="noopener noreferrer" aria-label="Instagram">ig</a>
      </div>
      <p class="footer-web-design footer-web-design-desktop">
        <span>Design by</span> <a href="https://stillbuilt.co" target="_blank" rel="noopener noreferrer" aria-label="Stillbuilt"><img src="/images/stillbuilt-logo-animated-blink.svg" alt="Stillbuilt" width="802" height="130" class="footer-web-design-logo" /></a>
      </p>
      <div class="footer-gc">
        <button id="giftCardFooterBtn" class="gc-btn">{f.giftCardButtonLabel ?? 'Check Gift Card Balance'}</button>
      </div>
      <div class="footer-credits">
        <p>{s.copyright ?? "© 151 Coffee, LLC. It's a Good Day to Have a Good Day."}</p>
        <p class="footer-web-design footer-web-design-mobile">
          <span>Design by</span> <a href="https://stillbuilt.co" target="_blank" rel="noopener noreferrer" aria-label="Stillbuilt"><img src="/images/stillbuilt-logo-animated-blink.svg" alt="Stillbuilt" width="802" height="130" class="footer-web-design-logo" /></a>
        </p>
      </div>
    </div>
  </div>
</footer>

<div id="giftCardModal" class="modal">
  <div class="modal-content">
    <button id="closeGiftCardModal" class="modal-close">&times;</button>
    <div class="crisp">
      <iframe data-src={giftCardUrl} style="width:100%;height:650px;border:none;"></iframe>
    </div>
  </div>
</div>
