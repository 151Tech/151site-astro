---
import { getSettings } from '../lib/storyblok';
import Editable from './Editable.astro';
interface Props {
  active?: string;
}
const { active = '' } = Astro.props;
const s = (await getSettings()) as any;
const siteName = s.siteName ?? '151 Coffee';
const giftCardLabel = 'Gift Card Balance';

const navLinks: { label: string; href: string }[] = s.nav ?? [
  { label: 'Menu', href: '/menu' },
  { label: 'Locations', href: '/locations' },
  { label: 'About', href: '/about' },
  { label: 'Careers', href: '/careers' },
  { label: 'Contact', href: '/#contact' },
  { label: 'Our Future', href: '/realestate' },
];

const cur = Astro.url.pathname.replace(/\/+$/, '') || '/';
function isActive(href: string): boolean {
  const base = (href.split('#')[0] || '').replace(/\/+$/, '');
  if (!base || base === '/') return false;
  const key = base.replace(/^\//, '');
  if (active && active === key) return true;
  return cur === base || cur.startsWith(base + '/');
}
---
<div id="top"></div>
<div class="loading-bar"></div>
<nav>
  <div class="nav-container">
    <a href="/" class="logo">
      <Editable blok={s} />
      <img src="/images/logo.webp" alt={siteName} width="164" height="192" class="logo-mark" />
    </a>
    <ul class="nav-links">
      {navLinks.map((link, i) => (
        <li><a href={link.href} class={`nav-link${isActive(link.href) ? ' active' : ''}`}>{link.label}</a></li>
      ))}
    </ul>
    <button type="button" id="giftCardNavBtn" class="main-menu-btn">{giftCardLabel}</button>
    <button type="button" class="menu-toggle" aria-label="Menu" aria-expanded="false" aria-controls="mobileNavDrawer">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>
