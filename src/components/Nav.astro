---
import { getSettings, imageUrl } from '../lib/storyblok';
interface Props {
  active?: string;
}
const { active = '' } = Astro.props;
const s = (await getSettings()) as any;
const siteName = s.siteName ?? '151 Coffee';
const logo = imageUrl(s.logo) ?? '/images/logo.png';
const giftCardLabel = s.giftCardLabel ?? 'Gift Card';

const navLinks: { label: string; href: string }[] = s.nav ?? [
  { label: 'Menu', href: '/menu' },
  { label: 'Locations', href: '/locations' },
  { label: 'About', href: '/about' },
  { label: 'Careers', href: '/careers' },
  { label: 'Contact', href: '/#contact' },
  { label: 'Our Future', href: '/ourfuture' },
];

const cur = Astro.url.pathname.replace(/\/+$/, '') || '/';
function isActive(href: string): boolean {
  const base = (href.split('#')[0] || '').replace(/\/+$/, '');
  if (!base || base === '/') return false;
  const key = base.replace(/^\//, '');
  if (active && active === key) return true;
  return cur === base || cur.startsWith(base + '/');
}
---
<div id="top"></div>
<div class="loading-bar"></div>
<nav>
  <div class="nav-container">
    <a href="/" class="logo">
      <img src={logo} alt={`${siteName} logo`} width="512" height="512" style="width:3rem;height:auto;" />
      <span>{siteName}</span>
    </a>
    <ul class="nav-links">
      {navLinks.map((link, i) => (
        <li><a href={link.href} class={`nav-link${isActive(link.href) ? ' active' : ''}`}>{link.label}</a></li>
      ))}
    </ul>
    <button type="button" id="giftCardNavBtn" class="main-menu-btn">{giftCardLabel}</button>
    <div class="menu-toggle" role="button" tabindex="0" aria-label="Toggle navigation menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </div>
  </div>
</nav>
