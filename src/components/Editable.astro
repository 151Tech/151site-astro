---
// The marker the Storyblok Visual Editor uses to outline a block in its
// preview. `blok` is the story or component object the markup belongs to.
// Rendered only where the editor runs: dev and the draft-preview deployment.
interface Props {
  blok?: { _editable?: string } | null;
}
const { blok } = Astro.props as Props;
const showMarkers = import.meta.env.STORYBLOK_DRAFT_MODE === 'true' || import.meta.env.DEV;
---
{showMarkers && <Fragment set:html={blok?._editable ?? ''} />}
