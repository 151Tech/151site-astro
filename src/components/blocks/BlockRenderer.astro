---
// Loops over a page's `sections` array (each entry: { type, ...fields })
// and renders the matching block component. Add a new block type by
// creating its component and adding one line to this map.
import PromoBanner from './PromoBanner.astro';
import ImageBanner from './ImageBanner.astro';
import SplitFeature from './SplitFeature.astro';
import CtaSection from './CtaSection.astro';
import TestimonialGrid from './TestimonialGrid.astro';
import StatStrip from './StatStrip.astro';
import FaqAccordion from './FaqAccordion.astro';
import CardGrid from './CardGrid.astro';

// Keyed by each block's `type` value on the section's content.
const BLOCK_COMPONENTS: Record<string, any> = {
  PromoBannerBlock: PromoBanner,
  ImageBannerBlock: ImageBanner,
  SplitFeatureBlock: SplitFeature,
  CtaSectionBlock: CtaSection,
  TestimonialGridBlock: TestimonialGrid,
  StatStripBlock: StatStrip,
  FaqAccordionBlock: FaqAccordion,
  CardGridBlock: CardGrid,
};

interface Props {
  sections?: Array<Record<string, any>>;
}
const { sections = [] } = Astro.props as Props;

// Tolerate sections created before this fix, whose `type` was accidentally
// written without the "Block" suffix (e.g. "PromoBanner" instead of
// "PromoBannerBlock") -- try the raw value first, then with "Block" appended.
function resolveComponent(type: string | undefined) {
  if (!type) return null;
  return BLOCK_COMPONENTS[type] ?? BLOCK_COMPONENTS[`${type}Block`] ?? null;
}
---
{sections.map((section, i) => {
  const Component = resolveComponent(section?.type);
  if (!Component) return null;
  return (
    <Component
      {...section}


    />
  );
})}
