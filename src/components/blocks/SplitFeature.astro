---
interface Props {
  heading?: string;
  headingSpan?: string;
  body?: string;
  image?: string;
  imageAlt?: string;
  ctaLabel?: string;
  ctaHref?: string;
  imagePosition?: 'left' | 'right';
  background?: 'light' | 'dark';
}
const {
  heading, headingSpan, body, image, imageAlt = '',
  ctaLabel, ctaHref, imagePosition = 'left', background = 'light',
  ...rest
} = Astro.props as Props & Record<string, any>;
const sideClass = imagePosition === 'right' ? 'blk-split--right' : '';
const bgClass = background === 'dark' ? 'blk-split--dark' : '';
---
<section class={`blk blk-split ${bgClass} ${sideClass}`} {...rest}>
  <div class="blk-split-inner">
    {image && (
      <div class="blk-split-img">
        <img src={image} alt={imageAlt} loading="lazy" decoding="async" />
      </div>
    )}
    <div class="blk-split-text">
      {heading && <h2>{heading}{headingSpan && <><br /><span>{headingSpan}</span></>}</h2>}
      {body && <p>{body}</p>}
      {ctaLabel && ctaHref && <a href={ctaHref} class="blk-split-cta">{ctaLabel}</a>}
    </div>
  </div>
</section>
