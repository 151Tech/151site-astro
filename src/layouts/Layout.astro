---
import Font from 'astro/components/Font.astro';
import { getSettings, imageUrl } from '../lib/storyblok';
import { ogImageUrl, metaDescription } from '../lib/seo';
import { TEMP_NOINDEX } from '../lib/temp-noindex';
// Page stylesheets are imported after this one, so they win the cascade.
import '../styles/style.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  bodyClass?: string;
  // Promo landing pages reached only by a texted link.
  noindex?: boolean;
}

const {
  title,
  description: rawDescription = '151 Coffee is a fast drive-thru coffee shop serving handcrafted espresso, cold brew, blended energy drinks, smoothies, teas & breakfast across Texas and Kansas.',
  ogImage,
  canonical,
  bodyClass = '',
  noindex = false,
} = Astro.props;
const description = metaDescription(rawDescription);

// Always the production domain, without a trailing slash (pages are served
// flat, see flattenRoutes in astro.config.mjs).
const canonicalPath = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/+$/, '');
const canonicalUrl = canonical ?? new URL(canonicalPath, 'https://www.151coffee.com').href;
const settingsData = (await getSettings()) as any;
const favicon = imageUrl(settingsData?.favicon) ?? '/favicon.ico';
// Small logo used inside the map pins (maplibre-map-helpers.js).
const logoMarkUrl = imageUrl(settingsData?.logo, { width: 64 });
const socialImage = ogImage ?? ogImageUrl(settingsData);

// The draft-preview deployment is never indexed.
const isDraftPreview = import.meta.env.STORYBLOK_DRAFT_MODE === 'true';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  {/* Italic faces aren't used above the fold, so only upright ones are preloaded. */}
  <Font cssVariable="--font-montserrat" preload={[{ style: 'normal' }]} />
  <Font cssVariable="--font-source-sans" preload={[{ style: 'normal' }]} />
  <Font cssVariable="--font-caveat" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <meta name="robots" content={isDraftPreview || noindex || TEMP_NOINDEX ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
  <meta name="author" content="151 Coffee" />
  <meta name="theme-color" content="#e4252b" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="151 Coffee" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  {socialImage && <meta property="og:image" content={socialImage} />}
  {socialImage && <meta property="og:image:alt" content={title} />}
  <meta property="og:locale" content="en_US" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  {socialImage && <meta name="twitter:image" content={socialImage} />}

  {/* All images and videos come from Storyblok's CDN. */}
  <link rel="preconnect" href="https://a.storyblok.com" crossorigin />

  <link rel="icon" href={favicon} />
  <slot name="head" />
  <script is:inline>if(!window.matchMedia('(prefers-reduced-motion:reduce)').matches)document.documentElement.classList.add('js-anim');</script>
</head>
<body class={bodyClass}>
  <slot />
  <script src="/js/script.js" is:inline defer></script>
  <script src="/js/animations.js" is:inline defer></script>
  <script src="/js/click-egg.js" is:inline defer></script>

  {/* Consent and analytics. Deferred scripts run in document order:
      consent.js (stored choice), analytics-loader.js (GA and Meta Pixel,
      only after "Accept All"), cookie-consent.js (the banner). */}
  <script
    define:vars={{
      gaId: import.meta.env.PUBLIC_GA_MEASUREMENT_ID || '',
      metaPixelId: import.meta.env.PUBLIC_META_PIXEL_ID || '',
      logoMarkUrl: logoMarkUrl || '',
    }}
    is:inline
  >
    window.COFFEE151_TRACKING_IDS = { gaId, metaPixelId };
    window.COFFEE151_LOGO_URL = logoMarkUrl;
  </script>
  <script src="/js/consent.js" is:inline defer></script>
  <script src="/js/analytics-loader.js" is:inline defer></script>
  <script src="/js/cookie-consent.js" is:inline defer></script>

  {/* Storyblok Visual Editor bridge, loaded only inside the editor (?_storyblok). */}
  <script is:inline>
    if (new URLSearchParams(window.location.search).has('_storyblok')) {
      var s = document.createElement('script');
      s.src = 'https://app.storyblok.com/f/storyblok-v2-latest.js';
      s.onload = function () {
        var bridge = new window.StoryblokBridge();
        bridge.on(['input', 'published', 'change'], function () {
          window.location.reload();
        });
      };
      document.head.appendChild(s);
    }
  </script>
</body>
</html>
