---
import Font from 'astro/components/Font.astro';
import { getSettings, imageUrl } from '../lib/storyblok';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  bodyClass?: string;
}

const {
  title,
  description = '151 Coffee is a fast drive-thru coffee shop serving handcrafted espresso, cold brew, blended energy drinks, smoothies, teas & breakfast across Texas and Kansas.',
  ogImage,
  canonical,
  bodyClass = '',
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, 'https://www.151coffee.com').href;
// Falls back to the static /favicon.ico in public/ until an editor picks one
// in Storyblok (settings/global -> Favicon).
const settingsData = (await getSettings()) as any;
const favicon = imageUrl(settingsData?.favicon) ?? '/favicon.ico';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <Font cssVariable="--font-inter" preload />
  <Font cssVariable="--font-bebas-neue" preload />
  <Font cssVariable="--font-caveat" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta name="author" content="151 Coffee" />
  <meta name="theme-color" content="#e63946" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="151 Coffee" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta property="og:locale" content="en_US" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}

  <link rel="icon" href={favicon} />
  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="/blocks.css" />
  <slot name="head" />
  <script is:inline>if(!window.matchMedia('(prefers-reduced-motion:reduce)').matches)document.documentElement.classList.add('js-anim');</script>
</head>
<body class={bodyClass}>
  <slot />
  <script src="/js/script.js" is:inline defer></script>
  <script src="/js/animations.js" is:inline defer></script>
  <script src="/js/cookie-consent.js" is:inline defer></script>

  <!--
    Storyblok's Visual Editor loads pages inside an iframe with a
    `_storyblok` query param. Only load its bridge there, never for real
    visitors. The bridge gives us click-to-highlight between the editor
    sidebar and this preview (via the `_editable` markers rendered by
    <Editable blok={...} />) and reloads the page on save/publish. A reload
    only pulls fresh *draft* content when this page is server-rendered per
    request (`npm run dev`, or a future draft deployment). On the static
    production build it just reloads the same prebuilt HTML, which is
    expected until the next auto-rebuild picks up the publish.
  -->
  <script is:inline>
    if (new URLSearchParams(window.location.search).has('_storyblok')) {
      var s = document.createElement('script');
      s.src = 'https://app.storyblok.com/f/storyblok-v2-latest.js';
      s.onload = function () {
        var bridge = new window.StoryblokBridge();
        bridge.on(['input', 'published', 'change'], function () {
          window.location.reload();
        });
      };
      document.head.appendChild(s);
    }
  </script>
</body>
</html>
