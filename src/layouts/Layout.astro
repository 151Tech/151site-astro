---
import Font from 'astro/components/Font.astro';
import { getSettings, imageUrl } from '../lib/storyblok';
import { ogImageUrl } from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  bodyClass?: string;
}

const {
  title,
  description = '151 Coffee is a fast drive-thru coffee shop serving handcrafted espresso, cold brew, blended energy drinks, smoothies, teas & breakfast across Texas and Kansas.',
  ogImage,
  canonical,
  bodyClass = '',
} = Astro.props;

// Points at the real domain even when this response is coming from the
// preview deployment's own *.webflow.io host, so a crawler that ignores
// noindex (some do, for canonical/duplicate-detection purposes) is still
// pointed at the real page rather than credited to a draft one. Explicit
// `canonical` prop callers are unaffected.
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, 'https://www.151coffee.com').href;
// Falls back to the static /favicon.ico in public/ until an editor picks one
// in Storyblok (settings/global -> Favicon).
const settingsData = (await getSettings()) as any;
const favicon = imageUrl(settingsData?.favicon) ?? '/favicon.ico';

// 74 of 88 indexable pages were shipping no og:image at all. The per-page
// seo.ogImage fields are populated in Storyblok, but every one of them points
// at a pre-migration /images/splash1.jpg path that no longer exists and is
// (correctly) rejected by imageUrl's Storyblok-only rule -- so the tag simply
// vanished. Rather than leave social and AI preview cards blank, fall back
// site-wide: settings_global > ogImage when an editor uploads a proper
// 1200x630 card, else the logo, which is square and not ideal but is a real
// asset. An explicit per-page ogImage prop still wins.
const socialImage = ogImage ?? ogImageUrl(settingsData);

// The draft-preview deployment (STORYBLOK_DRAFT_MODE=true, see
// src/lib/storyblok.ts) renders live unpublished content and shares this
// same codebase with production, on its own *.webflow.io domain. Nothing
// there should ever be indexed or credited as canonical -- it would put
// draft copy in search results and risk being read as duplicate content
// against the real site. See also src/pages/robots.txt.ts, which disallows
// the whole preview domain outright, and astro.config.mjs, which skips
// generating a sitemap for it.
const isDraftPreview = import.meta.env.STORYBLOK_DRAFT_MODE === 'true';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <Font cssVariable="--font-inter" preload />
  <Font cssVariable="--font-bebas-neue" preload />
  <Font cssVariable="--font-caveat" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <meta name="robots" content={isDraftPreview ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
  <meta name="author" content="151 Coffee" />
  <meta name="theme-color" content="#e63946" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="151 Coffee" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  {socialImage && <meta property="og:image" content={socialImage} />}
  {socialImage && <meta property="og:image:alt" content={title} />}
  <meta property="og:locale" content="en_US" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  {socialImage && <meta name="twitter:image" content={socialImage} />}

  <link rel="icon" href={favicon} />
  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="/blocks.css" />
  <slot name="head" />
  <script is:inline>if(!window.matchMedia('(prefers-reduced-motion:reduce)').matches)document.documentElement.classList.add('js-anim');</script>
</head>
<body class={bodyClass}>
  <slot />
  <script src="/js/script.js" is:inline defer></script>
  <script src="/js/animations.js" is:inline defer></script>
  <script src="/js/cookie-consent.js" is:inline defer></script>

  <!--
    Storyblok's Visual Editor loads pages inside an iframe with a
    `_storyblok` query param. Only load its bridge there, never for real
    visitors. The bridge gives us click-to-highlight between the editor
    sidebar and this preview (via the `_editable` markers rendered by
    <Editable blok={...} />) and reloads the page on save/publish. A reload
    only pulls fresh *draft* content when this page is server-rendered per
    request (`npm run dev`, or a future draft deployment). On the static
    production build it just reloads the same prebuilt HTML, which is
    expected until the next auto-rebuild picks up the publish.
  -->
  <script is:inline>
    if (new URLSearchParams(window.location.search).has('_storyblok')) {
      var s = document.createElement('script');
      s.src = 'https://app.storyblok.com/f/storyblok-v2-latest.js';
      s.onload = function () {
        var bridge = new window.StoryblokBridge();
        bridge.on(['input', 'published', 'change'], function () {
          window.location.reload();
        });
      };
      document.head.appendChild(s);
    }
  </script>
</body>
</html>
