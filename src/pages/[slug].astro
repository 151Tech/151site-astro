---
export const prerender = import.meta.env.STORYBLOK_DRAFT_MODE !== 'true';
import Layout from '../layouts/Layout.astro';
import Editable from '../components/Editable.astro';
import { getLandingPages, getSettings, getDrinks, getCategories, imageUrl } from '../lib/storyblok';

// SMS/text-link discount landing pages -- every story under the
// landing-pages/ folder gets a route here automatically (see
// storyblok/push-landing-pages.mjs to seed new ones, or duplicate the
// "template" story directly in Storyblok, no code change needed either way).
// A plain top-level [slug] (rather than nesting under e.g. /deals/) is
// deliberate: these links go out over text, so the URL itself needs to stay
// as short as the offer's own short code was on the old site.
export async function getStaticPaths() {
  const pages = await getLandingPages();
  return pages.map((p: any) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const [pages, settingsData, drinksEntries, categoryEntries] = await Promise.all([
  getLandingPages(),
  getSettings(),
  getDrinks(),
  getCategories(),
]);
const page = pages.find((p: any) => p.slug === slug);

if (!page) return Astro.redirect('/');

const logoUrl = imageUrl((settingsData as any)?.logo, { width: 120 });
const bonusImage = imageUrl(page.image, { width: 700 });

// Per-slug background override -- veterans-day only, per the owner's
// request -- rather than a new generic CMS field for a one-off ask (same
// pattern as LOCATION_COORD_OVERRIDES in src/lib/storyblok.ts).
const BACKGROUND_OVERRIDES: Record<string, string> = {
  'veterans-day': '/images/landing/veterans-day-bg.jpg',
};
const backgroundImage = BACKGROUND_OVERRIDES[slug as string];

// At desktop widths the full-bleed photo background gives way to a small
// framed image centered above the (now vertically centered) text -- same
// per-slug override pattern as BACKGROUND_OVERRIDES above.
const DESKTOP_HERO_OVERRIDES: Record<string, string> = {
  'veterans-day': '/images/landing/veterans-day-desktop.jpg',
};
const desktopHeroImage = DESKTOP_HERO_OVERRIDES[slug as string];

// Every other landing page (no bespoke art of its own) gets a photo above
// the offer text that lands on a different real drink on every page load.
// Deliberately a narrower, curated pool rather than the "Help Me Decide"
// picker's broad exclusion list on /menu (see catSlug()/DECIDE_EXCLUDED_CATS
// there): these should only ever show off Dirty Pop, Energy, Teas, or
// Refreshers -- the colorful, photogenic drinks -- not coffee/espresso/cold
// brew shots that look near-identical in a small photo.
const REFID_TO_CAT_SLUG: Record<string, string> = Object.fromEntries(
  categoryEntries.map((c: any) => [`categories/${c.slug}`, c.slug]),
);
const RANDOM_IMAGE_ALLOWED_CATS = new Set(['dirtypop', 'energy', 'teas', 'refreshers']);
// Requested at tablet-band resolution/quality (not the old phone-band 500px)
// since the same image now has to fill a much larger, more visible band on
// iPad/Surface-class screens (see the large-tablet tier in <style>) as well
// as the smaller phone one -- one larger, sharper asset covers both rather
// than serving a soft upscale on the bigger screens.
const randomDrinkImages: string[] = drinksEntries
  .filter((d: any) => RANDOM_IMAGE_ALLOWED_CATS.has(REFID_TO_CAT_SLUG[d.category] ?? ''))
  .map((d: any) => imageUrl(d.image, { width: 1200, quality: 90 }))
  .filter(Boolean) as string[];
const hasRandomImage = !backgroundImage && !desktopHeroImage && randomDrinkImages.length > 0;

// veterans-day's own flag photo gets the same angled band treatment as the
// random-drink pages below, on mobile/tablet -- it just shows a fixed image
// instead of a random one. Desktop (>=900px, see the has-desktop-hero
// override further down) is unaffected: that already swaps to its own
// framed hero image and this flag band is hidden there.
const showDiagPhoto = hasRandomImage || !!backgroundImage;

function escapeHtml(s: string): string {
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}
// CMS copy is plain text, so rather than asking editors to hand-mark spans
// in Storyblok, the punchy words -- dollar amounts, percentages, and a
// short list of promo keywords -- get pulled out and colored automatically
// wherever they appear in the headline or offer line.
const KEYWORD_PATTERN = /(\$\d+(?:\.\d+)?|\d+%|\bFREE\b|\bOFF\b)/gi;
function highlight(text: string): string {
  return escapeHtml(text).replace(KEYWORD_PATTERN, '<span class="landing-highlight">$1</span>');
}
---

<Layout
  title={`${page.headline || 'Special Offer'} | 151 Coffee`}
  description={page.offer || undefined}
  bodyClass="landing-page-body"
  noindex
>
  <Editable blok={page} />

  <main
    class:list={[
      'landing-page',
      {
        'has-bg-image': !!backgroundImage,
        'has-desktop-hero': !!desktopHeroImage,
        'has-random-image': hasRandomImage,
        'has-diag-photo': showDiagPhoto,
      },
    ]}
    style={backgroundImage ? `--landing-bg: url(${backgroundImage})` : undefined}
  >
    {!hasRandomImage && (
      <a href="/" class="landing-logo" aria-label="151 Coffee home">
        {logoUrl ? <img src={logoUrl} alt="151 Coffee" /> : <span>151 Coffee</span>}
      </a>
    )}

    {desktopHeroImage && (
      <div class="landing-desktop-hero">
        <img src={desktopHeroImage} alt="" loading="eager" />
      </div>
    )}

    {showDiagPhoto && (
      <a
        href="/"
        class="landing-diag-photo"
        aria-label="151 Coffee home"
        data-random-images={hasRandomImage ? JSON.stringify(randomDrinkImages) : undefined}
      >
        {hasRandomImage ? (
          <img data-random-image-el alt="" loading="eager" />
        ) : (
          <img src={backgroundImage} alt="" loading="eager" class="landing-diag-photo-img--top" />
        )}
      </a>
    )}

    <div class="landing-content">
      {page.eyebrow && <p class="landing-eyebrow">{page.eyebrow}</p>}
      {page.headline && <h1 class="landing-headline" set:html={highlight(page.headline)} />}
      {page.offer && <p class="landing-offer" set:html={highlight(page.offer)} />}
      {page.code && <p class="landing-code">{page.code}</p>}

      {bonusImage && (
        <div class="landing-image">
          <img src={bonusImage} alt="" loading="eager" />
        </div>
      )}

      {page.instructions && <p class="landing-instructions">{page.instructions}</p>}

      <a href={page.ctaHref || '/locations'} class="btn-primary landing-cta">
        {page.ctaLabel || 'Find a Location'}
      </a>

      {page.terms && <p class="landing-terms">{page.terms}</p>}
    </div>
  </main>
</Layout>

{hasRandomImage && (
  <script>
    const wrap = document.querySelector('[data-random-images]');
    if (wrap) {
      const images: string[] = JSON.parse(wrap.getAttribute('data-random-images') || '[]');
      const img = wrap.querySelector('[data-random-image-el]') as HTMLImageElement | null;
      if (img && images.length) {
        img.src = images[Math.floor(Math.random() * images.length)];
      }
    }
  </script>
)}

<style>
  /* Fixed, full-viewport, non-scrolling by design: these are opened straight
     from a text message, often one-handed, and the entire offer -- not just
     a hint of it above a scroll indicator -- has to be readable the instant
     the page paints. `100dvh` (not `100vh`) accounts for a mobile browser's
     collapsing address bar, which `vh` overshoots on first paint. The bonus
     photo is the one thing allowed to disappear first: it's real content on
     a tall phone, but the two media queries below drop it (and then tighten
     spacing further) before anything else gives up, on shorter screens. */
  :global(body.landing-page-body) {
    overflow: hidden;
    height: 100dvh;
  }

  .landing-page {
    position: fixed;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: radial-gradient(circle at 50% 0%, rgba(230, 57, 70, 0.25) 0%, transparent 55%), var(--black);
    padding: max(1.1rem, env(safe-area-inset-top)) 1.25rem max(1.1rem, env(safe-area-inset-bottom));
    overflow: hidden;
  }

  /* Mobile/tablet no longer uses a full-bleed background photo at all --
     veterans-day's flag image now runs through the same angled
     .landing-diag-photo band as the random-drink pages (see showDiagPhoto
     above). `.has-bg-image` only still matters at the >=900px desktop tier
     below, where it swaps to a framed hero image instead. */

  .landing-logo {
    flex: 0 0 auto;
    display: block;
    margin-bottom: 0.6rem;
  }
  .landing-logo img {
    height: 72px;
    width: auto;
    display: block;
  }
  .landing-logo span {
    font-family: var(--font-bebas-neue), 'Impact', sans-serif;
    color: var(--white);
    font-size: 1.1rem;
    letter-spacing: 0.04em;
  }

  .landing-content {
    flex: 1 1 auto;
    min-height: 0;
    width: 100%;
    max-width: 480px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0.8rem;
  }

  .landing-eyebrow {
    flex: 0 0 auto;
    margin: 0;
    color: var(--red-soft);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .landing-headline {
    flex: 0 0 auto;
    margin: 0;
    font-family: var(--font-bebas-neue), 'Impact', sans-serif;
    color: var(--white);
    line-height: 1.02;
    letter-spacing: 0.01em;
    font-size: clamp(1.9rem, 9vw, 3rem);
  }

  .landing-offer {
    flex: 0 0 auto;
    margin: 0;
    color: var(--white);
    font-size: clamp(1rem, 4vw, 1.2rem);
    line-height: 1.35;
    max-width: 34ch;
  }

  /* :global is required here: this span is injected via set:html (see
     highlight() in the frontmatter), so it never receives Astro's scoped
     data-astro-* attribute, and a plain `.landing-highlight { ... }` rule
     (compiled to `.landing-highlight[data-astro-xxxxx]`) would silently
     never match it. */
  :global(.landing-highlight) {
    color: var(--red);
  }

  .landing-code {
    flex: 0 0 auto;
    margin: 0.15rem 0;
    display: inline-block;
    padding: 0.4rem 1.1rem;
    border: 2px dashed var(--red);
    border-radius: var(--radius-pill);
    color: var(--white);
    font-family: var(--font-inter), monospace;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  /* Allowed to shrink (and get clipped by its own overflow:hidden) before
     any text block does -- see the top-of-file comment. */
  .landing-image {
    flex: 1 1 auto;
    min-height: 0;
    width: 100%;
    max-width: 260px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: var(--radius);
    margin: 0.2rem 0;
  }
  .landing-image img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .landing-instructions {
    flex: 0 0 auto;
    margin: 0;
    color: var(--light-gray);
    font-size: 0.85rem;
    line-height: 1.4;
    max-width: 36ch;
  }

  .landing-cta {
    flex: 0 0 auto;
    margin-top: 0.2rem;
  }

  .landing-terms {
    flex: 0 0 auto;
    margin: 0.3rem 0 0;
    color: var(--light-gray);
    opacity: 0.7;
    font-size: 0.7rem;
    line-height: 1.35;
    max-width: 38ch;
  }

  /* Drop the bonus photo first -- it was already the one thing explicitly
     allowed to go (see the top-of-file comment) -- to guarantee every text
     block still fits above the fold on a short/older phone (iPhone SE-class,
     ~667px tall, minus browser chrome). */
  @media (max-height: 700px) {
    .landing-image { display: none; }
    /* The base gap above is sized for phones with room to spare; SE-class
       screens have none, so it's pulled back in here rather than letting
       the extra breathing room push the CTA/terms below the fold. */
    .landing-content { gap: 0.5rem; }
  }

  /* Below that, tighten spacing and type size further rather than drop
     anything else -- the offer, redemption steps, and CTA are the whole
     point of the page and are never allowed to require scrolling. */
  @media (max-height: 580px) {
    .landing-content { gap: 0.35rem; }
    .landing-headline { font-size: clamp(1.5rem, 8vw, 2.2rem); }
    .landing-offer { font-size: 0.95rem; }
    .landing-instructions, .landing-terms { font-size: 0.75rem; }
  }

  /* Narrower than the shared .btn-primary/.gc-btn padding on phones -- this
     targets .landing-cta only, so other buttons on the site keep their
     normal width. */
  @media (max-width: 480px) {
    .landing-cta {
      padding: 0.65rem 1.15rem;
      font-size: 0.9rem;
    }
  }

  /* Hidden by default -- only relevant once the desktop layout below turns
     it on for a slug that has one (see DESKTOP_HERO_OVERRIDES above). */
  .landing-desktop-hero {
    display: none;
  }

  /* Angled, edge-to-edge photo banner shared by every page that shows one
     above its text (see showDiagPhoto above): pages with no bespoke art get
     a random drink photo, veterans-day gets its own fixed flag photo.
     `.has-diag-photo` drops the page's own side padding so the band can run
     flush to both edges; `.landing-content` (below) puts side padding back
     for the text, plus the negative margin that lets it overlap the
     diagonal cut instead of leaving a hard seam. */
  /* No separate logo mark on any angled-photo page -- the random drink
     photos already have the 151 logo printed on the cup, and veterans-day's
     own photo band now runs the same way, flush to every edge including the
     top (has-desktop-hero restores the logo at the 900px+ tier below, where
     this band is hidden again in favor of the framed hero layout). */
  .landing-page.has-diag-photo {
    padding: 0 0 max(1.1rem, env(safe-area-inset-bottom));
  }
  .landing-page.has-diag-photo .landing-logo {
    display: none;
  }

  .landing-diag-photo {
    display: block;
    flex: 0 0 auto;
    width: 100%;
    height: clamp(150px, 32vh, 260px);
    position: relative;
    clip-path: polygon(0 0, 100% 0, 100% 78%, 0 100%);
    background: rgba(255, 255, 255, 0.04);
  }
  .landing-diag-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* veterans-day's flag sits in the upper portion of its source photo with
     plain sky below -- cover's default center crop pushes the flag out of
     frame on a tall band, so it's pinned to the top instead. */
  .landing-diag-photo img.landing-diag-photo-img--top {
    object-position: top center;
  }

  /* Large phones (iPhone Pro Max-class and similar, still under the
     900px tablet tier) have more width than the 260px mobile cap assumes --
     let the band grow a bit further so it makes better use of the extra
     screen instead of leaving it to the text below. */
  @media (min-width: 400px) and (max-width: 899px) {
    .landing-diag-photo {
      height: clamp(150px, 34vh, 320px);
    }
  }

  /* Everything below is sized off `min(vw, vh)` rather than fixed
     breakpoints: whichever dimension is tighter (a short SE-class phone's
     height, or a portrait tablet's... nothing, tablets are generous in
     both) drives the scale, so type and spacing shrink to fit a cramped
     screen and grow to actually fill a roomy one, continuously, instead of
     jumping between a handful of hand-tuned device tiers. */
  .landing-page.has-diag-photo .landing-content {
    padding: 0 1.25rem;
    /* Pulls the text up snug against the diagonal cut instead of leaving a
       gap -- constant rather than fluid, since the photo band above it is
       already vh-clamped and the text sizing below now shrinks to fit on
       its own. */
    margin-top: -1.35rem;
    gap: clamp(0.55rem, 2.4vh, 1.15rem);
  }

  .landing-page.has-diag-photo .landing-eyebrow {
    font-size: clamp(0.62rem, min(3.2vw, 1.7vh), 0.9rem);
  }
  .landing-page.has-diag-photo .landing-headline {
    font-size: clamp(1.7rem, min(9.5vw, 7.5vh), 3.8rem);
  }
  .landing-page.has-diag-photo .landing-offer {
    font-size: clamp(0.88rem, min(4.4vw, 3.1vh), 1.4rem);
  }
  .landing-page.has-diag-photo .landing-instructions {
    font-size: clamp(0.68rem, min(3.2vw, 2.1vh), 1.02rem);
  }
  .landing-page.has-diag-photo .landing-terms {
    font-size: clamp(0.58rem, min(2.7vw, 1.7vh), 0.8rem);
  }
  .landing-page.has-diag-photo .landing-cta {
    margin-top: 0;
    padding: clamp(0.55rem, 1.9vh, 0.85rem) clamp(1.1rem, 4vw, 2rem);
    font-size: clamp(0.78rem, min(4vw, 1.9vh), 1.02rem);
  }

  /* Large tablets (iPad Pro 13", Surface Pro 10, and sizes around them --
     roughly 1000-1400px wide) have room the phone-tuned clamp maxes above
     don't use: those caps were sized for phones and an iPad mini, so on a
     bigger tablet the type ends up looking small relative to all the extra
     space. This tier only raises the ceiling (min() picks the smaller of
     vw/vh either way, so a smaller tablet in this range still gets a
     smaller value) and only applies to pages without their own bespoke
     desktop layout -- has-desktop-hero pages switch away from this entirely
     at 900px (see below). */
  @media (min-width: 900px) {
    .landing-page.has-diag-photo:not(.has-desktop-hero) .landing-diag-photo {
      height: clamp(320px, 42vh, 560px);
      /* Brings the cut lower (was 78%/100%) so more of the photo shows
         through on the extra room a tablet has, rather than just stretching
         a thin band taller. */
      clip-path: polygon(0 0, 100% 0, 100% 90%, 0 100%);
    }
    .landing-page.has-diag-photo:not(.has-desktop-hero) .landing-eyebrow {
      font-size: clamp(0.9rem, min(2vw, 2.2vh), 1.3rem);
    }
    .landing-page.has-diag-photo:not(.has-desktop-hero) .landing-headline {
      font-size: clamp(3rem, min(6.5vw, 9vh), 5.5rem);
    }
    .landing-page.has-diag-photo:not(.has-desktop-hero) .landing-offer {
      font-size: clamp(1.3rem, min(2.6vw, 3.6vh), 1.9rem);
    }
    .landing-page.has-diag-photo:not(.has-desktop-hero) .landing-instructions {
      font-size: clamp(1rem, min(1.8vw, 2.4vh), 1.3rem);
    }
    .landing-page.has-diag-photo:not(.has-desktop-hero) .landing-terms {
      font-size: clamp(0.8rem, min(1.5vw, 1.9vh), 1rem);
    }
    .landing-page.has-diag-photo:not(.has-desktop-hero) .landing-cta {
      padding: clamp(0.85rem, 2vh, 1.15rem) clamp(2rem, 3vw, 2.75rem);
      font-size: clamp(1.02rem, min(2vw, 2.2vh), 1.25rem);
    }
  }

  /* Wide desktop viewport (not a phone/tablet held in a hand): a page with
     its own bespoke desktop art (has-desktop-hero, currently veterans-day
     only) drops the angled band entirely and shows a normal framed image,
     centered above the now vertically-centered text. Pages with no bespoke
     desktop art of their own just keep using .has-diag-photo, tuned further
     above for the large-tablet tier. */
  @media (min-width: 900px) {
    .landing-content {
      justify-content: center;
    }

    .landing-page.has-bg-image .landing-content {
      justify-content: center;
      padding-bottom: 0;
    }

    .landing-page.has-desktop-hero .landing-desktop-hero {
      display: block;
      flex: 0 0 auto;
      width: 100%;
      max-width: 420px;
      max-height: 32vh;
      margin-bottom: 1.25rem;
      border-radius: var(--radius);
      overflow: hidden;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.45);
    }
    .landing-page.has-desktop-hero .landing-desktop-hero img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* veterans-day is the one page with both has-desktop-hero and
       has-diag-photo -- undo the mobile/tablet angled-band treatment here so
       it falls back to the framed-hero layout above instead of showing both. */
    .landing-page.has-desktop-hero.has-diag-photo {
      padding: max(1.1rem, env(safe-area-inset-top)) 1.25rem max(1.1rem, env(safe-area-inset-bottom));
    }
    .landing-page.has-desktop-hero.has-diag-photo .landing-logo {
      display: block;
    }
    .landing-page.has-desktop-hero.has-diag-photo .landing-diag-photo {
      display: none;
    }
    .landing-page.has-desktop-hero.has-diag-photo .landing-content {
      padding: 0 1.25rem;
      margin-top: 0;
      gap: 0.8rem;
    }
    .landing-page.has-desktop-hero.has-diag-photo .landing-eyebrow {
      font-size: 0.8rem;
    }
    .landing-page.has-desktop-hero.has-diag-photo .landing-headline {
      font-size: clamp(1.9rem, 9vw, 3rem);
    }
    .landing-page.has-desktop-hero.has-diag-photo .landing-offer {
      font-size: clamp(1rem, 4vw, 1.2rem);
    }
    .landing-page.has-desktop-hero.has-diag-photo .landing-instructions {
      font-size: 0.85rem;
    }
    .landing-page.has-desktop-hero.has-diag-photo .landing-terms {
      font-size: 0.7rem;
    }
  }
</style>
