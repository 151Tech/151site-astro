---
export const prerender = import.meta.env.STORYBLOK_DRAFT_MODE !== 'true';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import HeroVideo from '../components/HeroVideo.astro';
import BlockRenderer from '../components/blocks/BlockRenderer.astro';
import Editable from '../components/Editable.astro';
import { getPage, getSettings, getLocations, unwrapSingletons, imageUrl, mediaUrl } from '../lib/storyblok';
import JsonLd from '../components/JsonLd.astro';
import { faqAnswerHtml } from '../lib/faq';
import { graph, organizationSchema, locationSchema } from '../lib/seo';
import InstagramCarousel from '../components/InstagramCarousel.astro';
import type { InstagramMedia } from '../lib/instagram';

// The Instagram Graph API needs a KV binding (INSTAGRAM_CACHE) that only
// exists under the Cloudflare adapter Webflow Cloud injects in production --
// it isn't there in plain `astro dev`, and `cloudflare:workers` doesn't even
// exist as a module outside a Workers runtime. This dynamic import, gated on
// DEV, is what keeps local dev working: Vite only resolves it if the line
// actually runs, so a bare `astro dev` never touches it.
let instagramMedia: InstagramMedia[] | null = null;
if (!import.meta.env.DEV) {
  try {
    const [{ env }, { getLatestInstagramMedia }] = await Promise.all([
      import('cloudflare:workers'),
      import('../lib/instagram'),
    ]);
    instagramMedia = await getLatestInstagramMedia(env as any);
  } catch (err) {
    console.error('[instagram] unavailable on this request', err);
  }
}

// TEMPORARY: owner asked for the section back before the real OAuth/API
// integration above is authorized. These 3 cards are real, self-hosted
// exports of actual recent @151coffee Instagram posts (locally-hosted mp4s,
// not a live embed - same reasoning as the old TikTok cards: no signed/
// expiring CDN URLs baked into prerendered HTML). Each links out to its own
// real permalink (derived from the post's shortcode), not the profile page.
// Remove this block once instagramMedia above is reliably populated.
if (!instagramMedia) {
  instagramMedia = [
    {
      id: 'DdcFTR4ANIZ',
      permalink: 'https://www.instagram.com/p/DdcFTR4ANIZ/',
      mediaUrl: '/images/instagram/ig-1.jpg',
      videoUrl: '/videos/instagram/ig-1.mp4',
      caption: '',
      timestamp: '',
    },
    {
      id: 'DdJeBs_xSy4',
      permalink: 'https://www.instagram.com/p/DdJeBs_xSy4/',
      mediaUrl: '/images/instagram/ig-2.jpg',
      videoUrl: '/videos/instagram/ig-2.mp4',
      caption: '',
      timestamp: '',
    },
    {
      id: 'DdefzadkwAo',
      permalink: 'https://www.instagram.com/p/DdefzadkwAo/',
      mediaUrl: '/images/instagram/ig-3.jpg',
      videoUrl: '/videos/instagram/ig-3.mp4',
      caption: '',
      timestamp: '',
    },
  ];
}

const [homeData, settingsData, locationsEntries] = await Promise.all([
  getPage('home'),
  getSettings(),
  getLocations(),
]);

const p = unwrapSingletons(homeData as any, [
  'seo', 'hero', 'visibility', 'featuredDrink', 'menuSection', 'locationsSection',
  'cta', 'reviews', 'investment', 'faqs', 'contact', 'investBanner',
]);
/* ---------------------------------------------------------------------
   Temporary copy overrides - 2026-10-06

   This site is being retired in favour of WordPress and this repo is
   becoming an archive, so these edits are applied in code rather than in
   Storyblok: the CMS is not where this copy will live, and a hand-edit to
   storyblok-snapshot.json would be wiped by the next rebuild anyway.

   Each one is a targeted replacement rather than a whole-field rewrite. If
   the underlying copy is ever changed in Storyblok the match simply fails
   and the original shows through, which is visible - a rewrite would
   silently reinstate today's wording over tomorrow's.
   --------------------------------------------------------------------- */
function overrideCopy(text: string, find: string, replaceWith: string): string {
  return typeof text === 'string' ? text.split(find).join(replaceWith) : text;
}

if (p.featuredDrink?.description) {
  // The drink's full name is "Pumpkin Caramel Brulee Latte".
  p.featuredDrink.description = overrideCopy(
    p.featuredDrink.description,
    'Pumpkin Caramel Br\u00fbl\u00e9e.',
    'Pumpkin Caramel Br\u00fbl\u00e9e Latte.',
  );
}

// The food menu is not at every store yet, and "Select Locations Only" does
// not say which - the two it is missing from are the ones people ask about.
for (const card of p.menuSection?.cards ?? []) {
  if (card?.subtitle === 'Select Locations Only') {
    card.subtitle = 'Not Yet at North Richland Hills or Flower Mound';
  }
  // Wrapped to two lines on a phone, and the card it sits on is already
  // labelled "Drink Menu" - the word was doing nothing the second time.
  if (card?.subtitle === 'Find Your New Favorite Drink') {
    card.subtitle = 'Find Your New Favorite';
  }
}

for (const faq of p.faqs?.items ?? []) {
  if (!faq?.answer) continue;
  faq.answer = overrideCopy(faq.answer, 'teas, kids drinks', 'teas, and kids drinks');
  faq.answer = overrideCopy(
    faq.answer,
    'Most stores have hot food items like burritos and bagels, and baked treats.',
    'We have hot food items like burritos and bagels, and baked treats, at all locations except North Richland Hills and Flower Mound.',
  );
}

const s = (settingsData as any) ?? {};
// `social` is a singleton nested blok, so Storyblok returns it as a one-item
// array. Passing it through unwrapped left every link in the Instagram
// section on its hardcoded fallback: tiktok and instagram happened to match
// the real accounts, so only Facebook (fallback "#") showed the breakage.
const socialLinks = Array.isArray(s.social) ? s.social[0] : s.social;
const locations = locationsEntries
  .sort((a: any, b: any) => (Number(a.displayOrder) || 99) - (Number(b.displayOrder) || 99));

// The FAQ section below renders as plain <details> markup, which leaves a
// machine to infer which text is the question and which is the answer from
// the HTML alone. FAQPage makes each pairing explicit instead, which is what
// answer engines read when deciding what this brand's own site says about a
// question. Google stopped showing FAQ rich results for most sites in 2023,
// so this is for machine-readability rather than for a SERP treatment.
// Built from the same Storyblok items the section renders, so an editor
// adding a Q&A gets the structured data for free and the two can't drift.
// These two are code-level defaults rather than Storyblok content: they
// replace the standalone /loyalty policy page (removed - see git history),
// and appending them here means they can't be lost to a snapshot rebuild
// the way a hand-edit to storyblok-snapshot.json would be. A
// `pages/home` faqs.items edit in Storyblok can
// still add, remove, or reorder around them like any other FAQ entry.
const loyaltyFaqItems = [
  {
    question: 'Does 151 Coffee have discount days?',
    answer:
      "Yes, we do! Sign up for a loyalty account at your nearest store to stay up to date. Note: this isn't tied to birthdays or a set day of the week. Your discounts are personalized to your account.",
  },
  {
    question: "It's my birthday! Does 151 do anything?",
    answer:
      "Unfortunately we don't offer free birthday drinks, but our baristas would love to celebrate you in line!",
  },
];
const faqItems: any[] = [...(p.faqs?.items ?? []), ...loyaltyFaqItems].filter((f: any) => f.question && f.answer);
const faqSchema = faqItems.length
  ? {
      "@type": "FAQPage",
      "mainEntity": faqItems.map((f: any) => ({
        "@type": "Question",
        "name": f.question,
        "acceptedAnswer": { "@type": "Answer", "text": f.answer },
      })),
    }
  : undefined;

// One graph rather than separate blocks, so the Organization, the FAQ and
// every store resolve against each other by @id. The Organization node moved
// out of the inline literal it used to be and into organizationSchema(),
// which adds sameAs (the four social URLs already in settings), founder,
// foundingDate, priceRange and the postal address.
//
// Each store is emitted here too: the homepage carries the store locator, so
// this is the page that legitimately lists all 15 as an ItemList, and it
// gives the brand's strongest page a complete local footprint instead of
// leaving the stores stranded on their own detail pages.
const homeSchema = graph(
  organizationSchema(s),
  faqSchema,
  {
    '@type': 'ItemList',
    name: '151 Coffee Locations',
    itemListElement: locations.map((loc: any, i: number) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: locationSchema(loc, s),
    })),
  },
);

---
<Layout title={p.seo?.title ?? '151 Coffee | Drive-Thru Coffee, Cold Brew & Energy Drinks'} description={p.seo?.description} ogImage={imageUrl(p.seo?.ogImage, { width: 1200, height: 630 })}>
  <Fragment slot="head">
    <JsonLd schema={homeSchema} />
  </Fragment>

  <Nav />

  {/* Hero */}
  <section class="hero">
    <div>
      <HeroVideo src={mediaUrl(p.hero?.videoUrl)} videoClass="hero-video" />
    </div>
    <div class="container">
      <div class="hero-content">
        <Editable blok={p} />
        {/* The kicker is part of the H1 on purpose: the slogan alone says
            nothing a search engine can match to "drive-thru coffee" or a
            region, so the page's main heading carried no keywords. */}
        <h1><span class="hero-kicker">{p.hero?.keywordLine || 'Drive-Thru Coffee in DFW & Kansas'}</span>{' '}{p.hero?.heading ?? '151 Coffee'}{[p.hero?.subheadingLine1 ?? "It's a Good Day", p.hero?.subheadingLine2 ?? 'to Have a Good Day'].filter((line) => line?.trim()).map((line) => <><br /><span>{line}</span></>)}</h1>
        <div class="hero-buttons">
          <a href={p.hero?.ctaHref ?? '/menu'} class="main-menu-btn2">{p.hero?.ctaLabel ?? 'See Our Menu'}</a>
        </div>
      </div>
    </div>
  </section>

  {/* Invest Banner */}
  {p.investBanner?.visible !== false && (
    <section class:list={['invest-banner', { 'has-image': !!imageUrl(p.investBanner?.image, { width: 200 }) }]}>
      <div class="invest-banner-inner">
        {imageUrl(p.investBanner?.image, { width: 200 }) && (
          <img
            class="invest-banner-image"
            src={imageUrl(p.investBanner?.image, { width: 200 })}
            alt={p.investBanner?.imageAlt ?? ''}
            width="120"
            height="160"
            loading="lazy"
            decoding="async"
          />
        )}
        <div class="invest-banner-content">
          <Editable blok={p.investBanner} />
          <p class="invest-banner-title">{p.investBanner?.title ?? 'Invest in 151 Coffee'}</p>
          <p class="invest-banner-blurb">
            {p.investBanner?.blurb ?? "Our next investment round isn't open yet, but it's coming soon. Join the waitlist to be first in line."}
          </p>
          <button type="button" class="invest-banner-btn" id="investBannerBtn">
            {p.investBanner?.buttonLabel ?? 'Learn More'}
          </button>
        </div>
      </div>
    </section>
  )}

  <BlockRenderer sections={p.sectionsAfterHero} />

  {/* Featured Drink */}
  {p.featuredDrink?.visible !== false && (
    <section class="featured-drink">
      <div class="featured-inner">
        <Editable blok={p.featuredDrink} />
        <div class="featured-visual">
          <div class="featured-card">
            <div class="drink-img-wrap">
              {imageUrl(p.featuredDrink?.image, { width: 960 }) && (
                <img src={imageUrl(p.featuredDrink?.image, { width: 960 })} alt={p.featuredDrink?.imageAlt ?? p.featuredDrink?.name ?? 'Featured drink'} width="480" height="480" decoding="async" />
              )}
            </div>
          </div>
        </div>
        <div class="featured-text">
          <span class="featured-badge">{p.featuredDrink?.badge ?? 'Featured Drink'}</span>
          <h2>{p.featuredDrink?.name ?? 'Our'}{' '}<br /><span>{p.featuredDrink?.nameBold ?? 'Coffee'}</span></h2>
          <p>{p.featuredDrink?.description ?? 'Handcrafted espresso, cold brew, and energy drinks made your way.'}</p>
          <a href={p.featuredDrink?.ctaHref ?? '/menu'} class="featured-cta">{p.featuredDrink?.ctaLabel ?? 'Explore the Menu'}</a>
        </div>
      </div>
    </section>
  )}

  {/* Instagram feed takes the Locations section's old slot and dark-grid
       background on the homepage; the full locator (search + map) still
       lives on its own page at /locations, linked from the nav and footer,
       so nothing here was the only way to find a store. */}
  <InstagramCarousel media={instagramMedia} social={socialLinks} />

  {/* Menu Section */}
  {(p.visibility?.menuGrid ?? true) && (
  <section class="features" id="features">
    <div class="container">
      <Editable blok={p.menuSection} />
      <div class="section-header"><h2>{p.menuSection?.heading ?? 'Explore Our Menu'}</h2></div>
      <div class="features-grid">
        {(p.menuSection?.cards ?? []).map((card: any, i: number) => (
          <a href={card.href} class="feature-card">
            <Editable blok={card} />
            {/* A real <img> (was a CSS background): lazy-loaded below the
                fold, responsive via srcset, and carries alt text - the
                Storyblok asset's alt when set, else the card title. */}
            {imageUrl(card.image, { width: 700 }) && (
              <div class="feature-card-media">
                <img
                  class="feature-card-img"
                  src={imageUrl(card.image, { width: 700 })}
                  srcset={[400, 700, 1000].map((w) => `${imageUrl(card.image, { width: w })} ${w}w`).join(', ')}
                  sizes="(min-width: 1200px) 560px, (min-width: 700px) 45vw, 92vw"
                  width="700"
                  height="700"
                  loading="lazy"
                  decoding="async"
                  alt={card.image?.alt || card.title || ''}
                />
              </div>
            )}
            <div class="card-content">
              <h3>
                {card.title}
                <span class={i === 1 ? 'feature-card-subtitle feature-card-subtitle--red' : 'feature-card-subtitle'}>{card.subtitle}</span>
              </h3>
              <span class="menu-btn">{card.label}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
  )}

  {/* CTA */}
  {(p.visibility?.cta ?? true) && (
  <section class="cta">
    <div class="container">
      <div class="cta-inner">
        <Editable blok={p.cta} />
        <div class="cta-content">
          <h2>{p.cta?.heading ?? 'Ready for a Good Day?'}</h2>
          <p>{p.cta?.body ?? 'Find your nearest 151 Coffee and see what everyone is talking about.'}</p>
          <div class="cta-buttons">
            <a href={p.cta?.ctaHref ?? '/locations'} class="btn-primary">{p.cta?.ctaLabel ?? 'Find a Location'}</a>
          </div>
        </div>
        <div class="cta-photo-stack">
          {(p.cta?.photos ?? []).map((photo: any, i: number) => (
            <div class={`cta-photo cta-photo--c${i}`}>
              <Editable blok={photo} />
              {imageUrl(photo.image, { width: 600 }) && (
                <img loading="lazy" decoding="async" src={imageUrl(photo.image, { width: 600 })} alt={photo.alt ?? ''} width="600" height="600" />
              )}
              {photo.signature === 'Plano Team' ? (
                <a href="/151-bounce.html" class="cta-signature cta-signature--link">{photo.signature}</a>
              ) : (
                <div class="cta-signature">{photo.signature}</div>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
  )}

  {/* Reviews */}
  {(p.visibility?.reviews ?? true) && (
  <section class="reviews" id="reviews">
    <div class="container">
      <div class="section-header"><h2>{p.reviews?.heading ?? 'What People Are Saying'}</h2></div>
      <div class="reviews-grid">
        {(p.reviews?.items ?? []).map((r: any, i: number) => (
          <figure class="review-card">
            <Editable blok={r} />
            <blockquote class="review-quote">{r.quote}</blockquote>
            <figcaption class="review-byline">
              <span class="review-avatar" aria-hidden="true">{(r.name ?? '?').charAt(0)}</span>
              <div class="review-byline-text">
                <p class="review-name">{r.name}</p>
                {r.location && <span class="review-location">{r.location}</span>}
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
  )}

  {/* FAQ */}
  {(p.visibility?.faq ?? true) && (
  <section class="faq" id="faq">
    <div class="container">
      <div class="section-header"><h2>{p.faqs?.heading ?? 'Frequently Asked Questions'}</h2></div>
      <div class="faq-list">
        {faqItems.map((faq: any, i: number) => (
          <details open={i===0}>
            <Editable blok={faq} />
            <summary>{faq.question}</summary>
            <p set:html={faqAnswerHtml(faq.answer)} />
          </details>
        ))}
      </div>
    </div>
  </section>
  )}

  {/* Contact */}
  {(p.visibility?.contact ?? true) && (
  <section class="contact" id="contact">
    <div class="container">
      <Editable blok={p.contact} />
      <div class="section-header"><h2>{p.contact?.heading ?? 'Get In Touch'}</h2></div>
      <div class="contact-form-wrapper">
        <form class="contact-form" name="contact" method="POST" data-ajax-form>
          <input type="hidden" name="form-name" value="contact" />
          <p class="visually-hidden-field" aria-hidden="true"><label>Leave this field blank: <input name="bot-field" /></label></p>
          <div class="form-header">
            <h3>{p.contact?.formHeading ?? 'Send Us a Message'}</h3>
            <p>{p.contact?.subheading ?? "We'd love to hear from you."}</p>
          </div>
          <div class="form-row">
            <div class="form-group"><label for="firstName">{p.contact?.firstNameLabel ?? 'First Name'}</label><input type="text" id="firstName" name="firstName" placeholder="First" required /></div>
            <div class="form-group"><label for="lastName">{p.contact?.lastNameLabel ?? 'Last Name'}</label><input type="text" id="lastName" name="lastName" placeholder="Last" required /></div>
          </div>
          <div class="form-row">
            <div class="form-group"><label for="email">{p.contact?.emailLabel ?? 'Email Address'}</label><input type="email" id="email" name="email" placeholder="john@company.com" required /></div>
            <div class="form-group"><label for="phone">{p.contact?.phoneLabel ?? 'Phone Number'}</label><input type="tel" id="phone" name="phone" placeholder="+1 (555) 123-4567" /></div>
          </div>
          <div class="form-group full-width"><label for="message">{p.contact?.messageLabel ?? 'Message'}</label><textarea id="message" name="message" placeholder="Your Message"></textarea></div>
          <button type="submit" class="form-submit"><span>{p.contact?.submitLabel ?? 'Submit'}</span></button>
        </form>
      </div>
    </div>
  </section>
  )}

  <BlockRenderer sections={p.sections} />

  <Footer />
</Layout>
