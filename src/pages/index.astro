---
export const prerender = import.meta.env.STORYBLOK_DRAFT_MODE !== 'true';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import HeroVideo from '../components/HeroVideo.astro';
import BlockRenderer from '../components/blocks/BlockRenderer.astro';
import Editable from '../components/Editable.astro';
import { getPage, getSettings, getLocations, unwrapSingletons, imageUrl, mediaUrl } from '../lib/storyblok';

const [homeData, settingsData, locationsEntries] = await Promise.all([
  getPage('home'),
  getSettings(),
  getLocations(),
]);

const p = unwrapSingletons(homeData as any, [
  'seo', 'hero', 'visibility', 'featuredDrink', 'menuSection', 'locationsSection',
  'cta', 'reviews', 'investment', 'faqs', 'contact',
]);
const s = (settingsData as any) ?? {};
const locations = locationsEntries
  .sort((a: any, b: any) => (Number(a.displayOrder) || 99) - (Number(b.displayOrder) || 99));

// The FAQ section below renders as plain <details> markup, which leaves a
// machine to infer which text is the question and which is the answer from
// the HTML alone. FAQPage makes each pairing explicit instead, which is what
// answer engines read when deciding what this brand's own site says about a
// question. Google stopped showing FAQ rich results for most sites in 2023,
// so this is for machine-readability rather than for a SERP treatment.
// Built from the same Storyblok items the section renders, so an editor
// adding a Q&A gets the structured data for free and the two can't drift.
const faqItems: any[] = (p.faqs?.items ?? []).filter((f: any) => f.question && f.answer);
const faqSchema = faqItems.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqItems.map((f: any) => ({
        "@type": "Question",
        "name": f.question,
        "acceptedAnswer": { "@type": "Answer", "text": f.answer },
      })),
    }
  : null;

const storesJson = JSON.stringify(locations.map((l: any) => ({
  name: l.name, address: l.address, city: l.city, state: l.state, zip: l.zip, lat: Number(l.lat), lng: Number(l.lng),
})));

---
<Layout title={p.seo?.title ?? '151 Coffee | Drive-Thru Coffee, Cold Brew & Energy Drinks'} description={p.seo?.description} ogImage={imageUrl(p.seo?.ogImage, { width: 1200, height: 630 })}>
  <fragment slot="head">
    <link rel="preconnect" href="https://unpkg.com" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": s.siteName ?? "151 Coffee",
      "url": "https://www.151coffee.com/",
      "logo": imageUrl(s.logo, { width: 512 }),
      "telephone": s.phone ?? "+1-682-325-2124",
      "email": s.email ?? "Contact@151Coffee.com",
      "slogan": s.slogan ?? "It's a Good Day to Have a Good Day.",
    })} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  </fragment>

  <Nav />

  <!-- Hero -->
  <section class="hero">
    <div>
      <HeroVideo src={mediaUrl(p.hero?.videoUrl)} videoClass="hero-video" />
    </div>
    <div class="container">
      <div class="hero-content">
        <Editable blok={p} />
        <h1>{p.hero?.heading ?? '151 Coffee'}<br /><span>{p.hero?.subheadingLine1 ?? "It's a Good Day"}</span><br /><span>{p.hero?.subheadingLine2 ?? 'to Have a Good Day'}</span></h1>
        <div class="hero-buttons">
          <a href={p.hero?.ctaHref ?? '/menu'} class="main-menu-btn2">{p.hero?.ctaLabel ?? 'See Our Menu'}</a>
        </div>
      </div>
    </div>
  </section>

  <BlockRenderer sections={p.sectionsAfterHero} />

  <!-- Featured Drink -->
  {p.featuredDrink?.visible !== false && (
    <section class="featured-drink">
      <div class="featured-inner">
        <Editable blok={p.featuredDrink} />
        <div class="featured-visual">
          <h2 class="featured-mobile-name">{p.featuredDrink?.name ?? 'Our'} <span>{p.featuredDrink?.nameBold ?? 'Coffee'}</span></h2>
          <div class="featured-card">
            <div class="drink-img-wrap">
              {imageUrl(p.featuredDrink?.image, { width: 960 }) && (
                <img src={imageUrl(p.featuredDrink?.image, { width: 960 })} alt={p.featuredDrink?.imageAlt ?? p.featuredDrink?.name ?? 'Featured drink'} width="480" height="480" decoding="async" />
              )}
            </div>
          </div>
        </div>
        <div class="featured-text">
          <span class="featured-badge">{p.featuredDrink?.badge ?? 'Featured Drink'}</span>
          <h2>{p.featuredDrink?.name ?? 'Our'}<br /><span>{p.featuredDrink?.nameBold ?? 'Coffee'}</span></h2>
          <p>{p.featuredDrink?.description ?? 'Handcrafted espresso, cold brew, and energy drinks made your way.'}</p>
          <a href={p.featuredDrink?.ctaHref ?? '/menu'} class="featured-cta">{p.featuredDrink?.ctaLabel ?? 'Explore the Menu'}</a>
        </div>
      </div>
    </section>
  )}

  <!-- Locations -->
  {(p.visibility?.locations ?? true) && (
  <section class="spaces" id="spaces">
    <div class="container">
      <Editable blok={p.locationsSection} />
      <div class="section-header"><h2>{p.locationsSection?.heading ?? 'Find Your Location'}</h2></div>
      <div class="locator">
        <div class="locator__panel">
          <div class="locator__search">
            <input type="text" id="locator-search" aria-label="Search locations" placeholder={p.locatorPlaceholder ?? 'Search by city, state, or zip...'} />
          </div>
          <div class="locator__list" id="locator-list"></div>
        </div>
        <div class="locator__map" id="locator-map"></div>
      </div>
    </div>
  </section>
  )}

  <!-- Menu Section -->
  {(p.visibility?.menuGrid ?? true) && (
  <section class="features" id="features">
    <div class="container">
      <Editable blok={p.menuSection} />
      <div class="section-header"><h2>{p.menuSection?.heading ?? 'Explore Our Menu'}</h2></div>
      <div class="features-grid">
        {(p.menuSection?.cards ?? []).map((card: any, i: number) => (
          <a href={card.href} class="feature-card">
            <Editable blok={card} />
            <div
              class="feature-card-img"
              style={imageUrl(card.image, { width: 700 })
                ? `background-image:url('${imageUrl(card.image, { width: 700 })}')`
                : undefined}
            ></div>
            <div class="card-content">
              <h3>
                {card.title}
                <span class="feature-card-subtitle" style={i===1?{color:'var(--red)'}:{}}>{card.subtitle}</span>
              </h3>
              <span class="menu-btn">{card.label}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
  )}

  <!-- CTA -->
  {(p.visibility?.cta ?? true) && (
  <section class="cta">
    <div class="container">
      <div class="cta-inner">
        <Editable blok={p.cta} />
        <div class="cta-content">
          <h2>{p.cta?.heading ?? 'Ready for a Good Day?'}</h2>
          <p>{p.cta?.body ?? 'Find your nearest 151 Coffee and see what everyone is talking about.'}</p>
          <div class="cta-buttons">
            <a href={p.cta?.ctaHref ?? '/locations'} class="btn-primary">{p.cta?.ctaLabel ?? 'Find a Location'}</a>
          </div>
        </div>
        <div class="cta-photo-stack">
          {(p.cta?.photos ?? []).map((photo: any, i: number) => (
            <div class={`cta-photo cta-photo--c${i}`}>
              <Editable blok={photo} />
              {imageUrl(photo.image, { width: 600 }) && (
                <img loading="lazy" decoding="async" src={imageUrl(photo.image, { width: 600 })} alt={photo.alt ?? ''} />
              )}
              <div class="cta-signature">{photo.signature}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
  )}

  <!-- Reviews -->
  {(p.visibility?.reviews ?? true) && (
  <section class="pricing" id="pricing">
    <div class="container">
      <div class="section-header"><h2>{p.reviews?.heading ?? 'What People Are Saying'}</h2></div>
      <div class="pricing-grid">
        {(p.reviews?.items ?? []).map((r: any, i: number) => (
          <div class="pricing-card">
            <Editable blok={r} />
            <p class="plan-price">{r.quote}</p>
            <div class="review-byline">
              <span class="review-avatar">{(r.name ?? '?').charAt(0)}</span>
              <div class="review-byline-text">
                <h3 class="plan-name">{r.name}</h3>
                {r.location && <span class="review-location">{r.location}</span>}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
  )}

  <!-- FAQ -->
  {(p.visibility?.faq ?? true) && (
  <section class="faq" id="faq">
    <div class="container">
      <div class="section-header"><h2>{p.faqs?.heading ?? 'Frequently Asked Questions'}</h2></div>
      <div class="faq-list">
        {(p.faqs?.items ?? []).map((faq: any, i: number) => (
          <details open={i===0}>
            <Editable blok={faq} />
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
  )}

  <!-- Contact -->
  {(p.visibility?.contact ?? true) && (
  <section class="contact" id="contact">
    <div class="container">
      <Editable blok={p.contact} />
      <div class="section-header"><h2>{p.contact?.heading ?? 'Get In Touch'}</h2></div>
      <div class="contact-form-wrapper">
        <form class="contact-form" name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field">
          <input type="hidden" name="form-name" value="contact" />
          <p style="display:none"><label>Leave this field blank: <input name="bot-field" /></label></p>
          <div class="form-header">
            <h3>{p.contact?.formHeading ?? 'Send Us a Message'}</h3>
            <p>{p.contact?.subheading ?? "We'd love to hear from you."}</p>
          </div>
          <div class="form-row">
            <div class="form-group"><label for="firstName">{p.contact?.firstNameLabel ?? 'First Name'}</label><input type="text" id="firstName" name="firstName" placeholder="First" required /></div>
            <div class="form-group"><label for="lastName">{p.contact?.lastNameLabel ?? 'Last Name'}</label><input type="text" id="lastName" name="lastName" placeholder="Last" required /></div>
          </div>
          <div class="form-row">
            <div class="form-group"><label for="email">{p.contact?.emailLabel ?? 'Email Address'}</label><input type="email" id="email" name="email" placeholder="john@company.com" required /></div>
            <div class="form-group"><label for="phone">{p.contact?.phoneLabel ?? 'Phone Number'}</label><input type="tel" id="phone" name="phone" placeholder="+1 (555) 123-4567" /></div>
          </div>
          <div class="form-group full-width"><label for="message">{p.contact?.messageLabel ?? 'Message'}</label><textarea id="message" name="message" placeholder="Your Message"></textarea></div>
          <button type="submit" class="form-submit"><span>{p.contact?.submitLabel ?? 'Submit'}</span></button>
        </form>
      </div>
    </div>
  </section>
  )}

  <BlockRenderer sections={p.sections} />

  <Footer />

  <script define:vars={{ storesJson, hours: s.hours, phone: s.phone }} is:inline>
    window.COFFEE151_STORES = JSON.parse(storesJson);
    window.COFFEE151_LOCATOR = { hours, phone };
  </script>
  <script src="/js/locator-loader.js" is:inline></script>
  <script is:inline>
    (function () {
      document.querySelectorAll('.cta-signature').forEach(function (sig) {
        var rotate = -10 + Math.random() * 14;
        var left = 42 + Math.random() * 16;
        var bottom = 0.7 + Math.random() * 1;
        sig.style.left = left + '%';
        sig.style.bottom = bottom + 'rem';
        sig.style.transform = 'translateX(-50%) rotate(' + rotate.toFixed(1) + 'deg)';
      });
    })();
  </script>
</Layout>
