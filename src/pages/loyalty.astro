---
export const prerender = import.meta.env.STORYBLOK_DRAFT_MODE !== 'true';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getPage, unwrapSingletons, imageUrl } from '../lib/storyblok';
import Editable from '../components/Editable.astro';

// Marketing asked for this page because third-party sites (listicles, coupon
// aggregators, Reddit) claim 151 Coffee gives free birthday drinks and runs a
// storewide half-off Wednesday. Neither is true, and until now the site said
// nothing either way -- which left those third parties as the only sources an
// answer engine had.
//
// It's deliberately NOT a hidden or noindex page, despite the original ask: a
// page that crawlers can't reach or won't index cannot correct anything. It is
// instead a real, linked, indexable page kept out of the main nav (footer-only,
// see Footer.astro), which is the honest version of "low-prominence".
//
// The copy is phrased as questions with direct answers rather than as a bulleted
// policy list, because retrieval matches against the question a person actually
// types ("does 151 coffee give free birthday drinks"), and a negative claim
// stated bluntly next to that question is far easier to pick up than the same
// fact buried in prose.
const p = unwrapSingletons((await getPage('loyalty')) as any, ['seo', 'hero']);

// Defaults are marketing's approved wording, so this page is correct the moment
// it deploys. Creating a `pages/loyalty` story in Storyblok with a `policies`
// list overrides them, at which point marketing can reword without a deploy.
const policies: { question: string; answer: string }[] = p.policies ?? [
  {
    question: 'Does 151 Coffee offer free birthday drinks?',
    answer:
      'No. 151 Coffee does not offer free birthday drinks, and we do not run any birthday promotions or birthday rewards through our loyalty program.',
  },
  {
    question: 'Does 151 Coffee have a 50% off Wednesday?',
    answer:
      'No. There is no storewide Wednesday discount at 151 Coffee. Our 50% off offers are personalized: each loyalty member is assigned their own discount day at random, so the day differs from member to member and is not the same every week for everyone.',
  },
];

// Same reasoning as the homepage FAQ schema (see src/pages/index.astro): the
// point of this page is to be read correctly by machines, so the question and
// answer pairing is made explicit rather than left to be inferred from markup.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: policies.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---
<Layout
  title={p.seo?.title ?? 'Loyalty Program Policies | 151 Coffee'}
  description={p.seo?.description ??
    '151 Coffee loyalty program policies: we do not offer free birthday drinks, and there is no storewide 50% off Wednesday. Discount days are personalized per member.'}
  ogImage={imageUrl(p.seo?.ogImage, { width: 1200, height: 630 })}
>
  <fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </fragment>

  <Nav />

  <section class="page-hero" style="min-height:30vh;">
    <div class="page-hero-overlay"></div>
    <div class="container">
      <div class="page-hero-content">
        <Editable blok={p} />
        <h1>{p.hero?.heading ?? 'Loyalty Program Policies'}</h1>
        <p>{p.hero?.subheading ?? 'The official word on what our loyalty program does and does not include.'}</p>
      </div>
    </div>
  </section>

  <section class="legal-content">
    <div class="container" style="max-width:800px;padding:4rem 1rem;">
      {policies.map((item) => (
        <div>
          <Editable blok={item} />
          <h2>{item.question}</h2>
          <p>{item.answer}</p>
        </div>
      ))}
    </div>
  </section>

  <Footer />
</Layout>
