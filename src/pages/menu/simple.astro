---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import '../../styles/menu.css';

// Compact menu view: /menu?simple=1 in a full-page iframe. /menu reads the
// flag and switches to its small-card layout (.menu-simple-mode in menu.css),
// sized to the full screen width.
---
{/* A view of /menu, so it is noindex and left out of the sitemap. */}
<Layout title="Simple Menu | 151 Coffee" description="A compact, small-card view of the 151 Coffee menu." noindex>
  <Fragment slot="head">
  </Fragment>
  <h1 class="sr-only">Simple Menu</h1>
  <div class="simple-menu-page">
    <iframe class="simple-menu-frame" src="/menu?simple=1" title="Simple menu"></iframe>
  </div>
</Layout>
