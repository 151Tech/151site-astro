---
import { getLocations } from '../../lib/storyblok';

export async function getStaticPaths() {
  const locations = await getLocations();
  const paths = [];
  for (const loc of locations as any[]) {
    const props = { slug: loc.slug, name: loc.name };
    // Name-based slug (e.g. /menu/keller) for internal links (Store Info
    // pages, etc.), plus the numbered short URL (e.g. /menu/8) that matches
    // the QR codes already printed for each store. displayOrder is that
    // same 1-15 numbering (see the location's displayOrder field).
    paths.push({ params: { store: loc.slug.replace(/^151-coffee-/, '') }, props });
    const order = loc.displayOrder;
    if (order != null) paths.push({ params: { store: String(Number(order)) } , props });
  }
  return paths;
}

const { slug, name } = Astro.props as { slug: string; name: string };
const target = `/menu?store=${slug}`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="refresh" content={`0;url=${target}`} />
  <link rel="canonical" href={`https://www.151coffee.com${target}`} />
  <meta name="robots" content="noindex" />
  <title>{name} Menu | 151 Coffee</title>
  <style>
    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #111;
      font-family: var(--font-inter), sans-serif;
      color: #fff;
    }
    .wrap { text-align: center; padding: 2rem; }
    p { color: rgba(255,255,255,0.6); font-size: 0.95rem; }
    a { color: #e63946; text-decoration: none; font-weight: 600; }
  </style>
</head>
<body>
  <div class="wrap">
    <p>Loading the menu for {name}&hellip;</p>
    <noscript><p><a href={target}>Tap here if you're not redirected</a></p></noscript>
  </div>
  <script define:vars={{ target }} is:inline>
    window.location.replace(target);
  </script>
</body>
</html>
