---
export const prerender = import.meta.env.STORYBLOK_DRAFT_MODE !== 'true';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import HeroVideo from '../components/HeroVideo.astro';
import BlockRenderer from '../components/blocks/BlockRenderer.astro';
import { getPage, getDrinks, getCategories, getLocations, unwrapSingletons, imageUrl, mediaUrl } from '../lib/storyblok';
import Editable from '../components/Editable.astro';
import JsonLd from '../components/JsonLd.astro';
import { graph, menuSchema, breadcrumbSchema } from '../lib/seo';

const [menuData, drinksEntries, categoryEntries, locationEntries] = await Promise.all([
  getPage('menu'),
  getDrinks(),
  getCategories(),
  getLocations(),
]);

const p = unwrapSingletons(menuData as any, [
  'seo', 'visibility', 'hero', 'labels', 'locationPicker', 'drinkPage', 'customize',
]);
const heroVideoSrc = mediaUrl(p.heroVideo);

// Hard-coded content for the "All Sodas Available" descriptor card (simple
// menu) -- not sourced from Storyblok, since this exact brand lineup/layout
// doesn't need to be editable there. Two explicit rows so Diet Coke can sit
// right next to Coca-Cola without needing to pair 1:1 with a bottom-row item.
const SODA_TOP_ROW = [
  { name: 'Coca-Cola', logo: '/images/soda-logos/coca-cola.webp' },
  { name: 'Diet Coke', logo: '/images/soda-logos/diet-coke.webp' },
  { name: 'Mountain Dew', logo: '/images/soda-logos/mountain-dew.webp' },
  { name: 'Fanta', logo: '/images/soda-logos/fanta.webp' },
  { name: 'Pepsi', logo: '/images/soda-logos/pepsi.webp' },
  { name: 'Diet Pepsi', logo: '/images/soda-logos/diet-pepsi.webp' },
];
const SODA_BOTTOM_ROW = [
  { name: 'Coke Zero', logo: '/images/soda-logos/coke-zero.webp' },
  { name: 'Sprite', logo: '/images/soda-logos/sprite.webp' },
  { name: 'Sprite Zero', logo: '/images/soda-logos/sprite-zero.webp' },
  { name: 'Dr. Pepper', logo: '/images/soda-logos/dr-pepper.webp' },
  { name: 'Diet Dr. Pepper', logo: '/images/soda-logos/diet-dr-pepper.webp' },
  { name: 'Mug Root Beer', logo: '/images/soda-logos/mug-root-beer.webp' },
];

// Same "labeled" descriptor-card treatment as the soda card, but with plain
// text (no logos) for the "Hot Teas Available" card -- hard-coded so the
// two-row order doesn't depend on Storyblok's item order.
const TEA_TOP_ROW = ['Paris', 'Earl Grey', 'Sencha'];
const TEA_BOTTOM_ROW = ['Mint', 'Cinnamon Spice'];
const allDrinks = drinksEntries
  .sort((a: any, b: any) => (Number(a.menuOrder) || 99) - (Number(b.menuOrder) || 99));

// The full menu as one Menu > MenuSection > MenuItem tree. This is the page
// that should be answering "what does 151 Coffee serve" for an answer engine,
// and it previously shipped 64 drinks as unannotated card markup.
const menuJsonLd = graph(
  menuSchema(allDrinks, categoryEntries as any[]),
  breadcrumbSchema([{ name: 'Home', url: '/' }, { name: 'Menu' }]),
);

// Locations are their own content collection too; drinks/categories reference
// them by Storyblok slug (same pattern as the category reference below).
const LOCATIONS = locationEntries
  .map((e: any) => ({
    slug: e.slug,
    refId: `locations/${e.slug}`,
    name: e.name,
    // "151 Coffee" is implied by the whole page, so repeating it on every
    // single location button is just noise. Strip it for display only.
    shortName: (e.name as string).replace(/^151 Coffee\s*/i, '') || e.name,
    city: e.city,
    state: e.state,
    order: Number(e.displayOrder) || 99,
  }))
  .sort((a: any, b: any) => a.order - b.order || a.name.localeCompare(b.name));

const LOCATION_REFID_TO_SLUG: Record<string, string> = Object.fromEntries(
  LOCATIONS.map((loc: any) => [loc.refId, loc.slug])
);

function toLocationSlugs(refs: string[] | undefined): string[] {
  return (refs ?? []).map((r) => LOCATION_REFID_TO_SLUG[r]).filter(Boolean);
}

// Categories are their own content collection (add / remove / edit in the Visual Editor).
// Each drink's `category` field references that category's Storyblok slug.
const CATEGORIES = categoryEntries
  .map((e: any) => ({
    tab: e.slug,
    refId: `categories/${e.slug}`,
    num: e.number,
    title: e.title,
    desc: e.description,
    extraCards: e.extraCards ?? [],
    hiddenByDefault: !!e.hiddenByDefault,
    unavailableAt: toLocationSlugs(e.unavailableAt),
    _editable: e._editable,
  }))
  .sort((a: any, b: any) => (parseInt(a.num) || 99) - (parseInt(b.num) || 99));

// Map a drink's category reference (Storyblok slug) back to its category tab slug.
const REFID_TO_SLUG: Record<string, string> = Object.fromEntries(
  CATEGORIES.map((cat: any) => [cat.refId, cat.tab])
);

function catSlug(drink: any): string {
  return REFID_TO_SLUG[drink.category] ?? '';
}

// Build DRINKS data object for the flavor + location filter JS
const drinksDataObj: Record<string, { tags: string[]; catSlug: string; unavailableAt: string[] }> = {};
for (const d of allDrinks) {
  drinksDataObj[d.slug] = { tags: d.tags ?? [], catSlug: catSlug(d), unavailableAt: toLocationSlugs(d.unavailableAt) };
}

const categoriesMetaObj: Record<string, { hiddenByDefault: boolean; unavailableAt: string[] }> = {};
for (const cat of CATEGORIES) {
  categoriesMetaObj[cat.tab] = { hiddenByDefault: cat.hiddenByDefault, unavailableAt: cat.unavailableAt };
}

const locationsMetaObj: Record<string, { name: string; shortName: string; city: string; state: string }> = {};
for (const loc of LOCATIONS) {
  locationsMetaObj[loc.slug] = { name: loc.name, shortName: loc.shortName, city: loc.city, state: loc.state };
}

const drinksJson = JSON.stringify(drinksDataObj);
const categoriesMetaJson = JSON.stringify(categoriesMetaObj);
const locationsMetaJson = JSON.stringify(locationsMetaObj);

// Group locations by state for the "Select Your Location" popup.
const locationsByState: Record<string, typeof LOCATIONS> = {};
for (const loc of LOCATIONS) {
  (locationsByState[loc.state] ??= []).push(loc);
}

const milks: string[] = p.customize?.milks ?? [];
const allFlavors: string[] = p.customize?.flavors ?? [];
const sfFlavors: string[] = p.customize?.sfFlavors ?? [];

// The flavor pills filter the menu by tag. A flavor no drink currently
// carries would just filter to an empty menu, so hide its selector. Food
// items (Hot Food, Treats) are excluded from this check: their tags (e.g.
// "Cinnamon" on a coffee cake) aren't real drink flavors, so they shouldn't
// keep a flavor selector alive on their own.
const FOOD_CATS = new Set(['hotfood', 'treats']);
const flavorsInUse: string[] = allDrinks
  .filter((d: any) => !FOOD_CATS.has(catSlug(d)))
  .flatMap((d: any) => d.tags ?? []);
const FLAVORS_WITH_DRINKS = new Set(flavorsInUse);

// Pills show automatically for any tag actually used on a drink -- adding a
// flavor tag in Storyblok (e.g. "Pumpkin") is enough, no separate list to
// maintain. customize.flavors only controls display ORDER for flavors it
// already lists; anything new gets appended in first-appearance order.
const newFlavors = [...new Set(flavorsInUse.filter((f) => !allFlavors.includes(f)))];
const orderedFlavors = [...allFlavors, ...newFlavors];
const flavors: { value: string; index: number }[] = orderedFlavors
  .map((f: string, index: number) => ({ value: f, index }))
  .filter(({ value }: any) => FLAVORS_WITH_DRINKS.has(value));

// Slim drink list for the "Help Me Decide" popup -- only what the card
// needs to render (name/subtitle/image). Hot Food, Treats, and Kids are
// excluded so the randomizer only ever lands on an actual drink someone
// would order on a whim -- a wider exclusion than FOOD_CATS above (which
// only needs to keep non-drink tags out of the flavor filter, not keep
// Kids drinks out of a "surprise me" pick).
const DECIDE_EXCLUDED_CATS = new Set(['hotfood', 'treats', 'kids']);
const decideDrinksArr = allDrinks
  .filter((d: any) => !DECIDE_EXCLUDED_CATS.has(catSlug(d)))
  .map((d: any) => ({
    name: d.name,
    subtitle: d.subtitle ?? '',
    image: imageUrl(d.image, { width: 640 }) ?? '',
    slug: d.slug,
  }))
  .filter((d: any) => d.image);
const decideDrinksJson = JSON.stringify(decideDrinksArr);

---
<Layout title={p.seo?.title ?? 'Menu | 151 Coffee - Coffee, Cold Brew, Energy & Dirty Pop'} description={p.seo?.description ?? 'Explore the full 151 Coffee menu. Signature espresso drinks, cold brew, blended energy, Dirty Pop sodas, refreshers, smoothies, teas, and more.'} ogImage={imageUrl(p.seo?.ogImage, { width: 1200, height: 630 })}>
  <Fragment slot="head">
    <link rel="stylesheet" href="/menu.css" />
    <JsonLd schema={menuJsonLd} />
  </Fragment>

  <Nav active="menu" />

  <section class="menu-hero">
    <Editable blok={p} />
    <HeroVideo src={heroVideoSrc} videoClass="hero-bg" />
    <div class="menu-hero-content">
      <h1>{p.hero?.heading ?? 'Our Menu'}</h1>
      <div class="menu-hero-actions">
        <button type="button" class="location-trigger" id="locationTrigger">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M12 21s7-6.5 7-12a7 7 0 1 0-14 0c0 5.5 7 12 7 12z" stroke="currentColor" stroke-width="1.8"/>
            <circle cx="12" cy="9" r="2.3" stroke="currentColor" stroke-width="1.8"/>
          </svg>
          <span id="locationTriggerLabel">{p.locationPicker?.triggerLabel ?? 'Select Your Location'}</span>
        </button>
        <!--
          Desktop-only shortcut to the same compact layout mobile visitors
          already get -- one drink per glance instead of the wide horizontal
          timeline. Hidden below 768px in menu.css (mobile IS that view
          already, there's nothing to switch to). Real navigation to its own
          page (/menu/simple) rather than a popup -- see that page for how
          it actually renders the compact view without a second template.
        -->
        <a href="/menu/simple" class="simple-menu-trigger">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect x="7" y="2.5" width="10" height="19" rx="2.2" stroke="currentColor" stroke-width="1.8"/>
            <line x1="10.5" y1="18" x2="13.5" y2="18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
          <span>Simple Menu</span>
        </a>
      </div>
    </div>
    <div class="cat-nav" id="catNav">
      <div class="cat-nav-inner">
        {CATEGORIES.map((cat: any, i: number) => (
          <button class={`cat-link${i === 0 ? ' active' : ''}`} data-tab={cat.tab}
            data-visible={cat.hiddenByDefault ? 'false' : undefined}
>{cat.title}</button>
        ))}
      </div>
    </div>
  </section>

  <div id="locationModal" class="modal">
    <div class="modal-content loc-modal-content">
      <button type="button" class="modal-close" id="closeLocationModal" aria-label="Close">&times;</button>
      <div class="loc-modal-inner">
        <h2>{p.locationPicker?.heading ?? 'Select Your Location'}</h2>
        <p>{p.locationPicker?.subtext ?? "See only what's available at your store. You can change this anytime."}</p>
        <div class="loc-modal-list">
          <button type="button" class="loc-modal-item loc-modal-item--all" data-store="">
            {p.locationPicker?.allLabel ?? 'All Locations'}
          </button>
          {Object.entries(locationsByState).map(([state, locs]: [string, any]) => (
            <div class="loc-modal-state">
              <p class="loc-modal-state-label">{state}</p>
              {locs.map((loc: any) => (
                <button type="button" class="loc-modal-item" data-store={loc.slug}>
                  {loc.shortName}
                </button>
              ))}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <div id="decideModal" class="modal decide-modal">
    <div class="modal-content decide-modal-content">
      <button type="button" class="modal-close" id="closeDecideModal" aria-label="Close">&times;</button>
      <div class="decide-stage" id="decideStage">
        <p class="decide-eyebrow">Today's Pick</p>
        <div class="decide-reel" id="decideReel">
          <div class="decide-card" id="decideCard">
            <div class="decide-card-inner">
              <div class="decide-img-wrap" id="decideImgWrap">
                <div class="decide-carousel-track" id="decideTrack"></div>
                <div class="decide-sparkles" id="decideSparkles"></div>
              </div>
              <h3 id="decideName"></h3>
              <p id="decideSubtitle"></p>
            </div>
          </div>
        </div>
        <button type="button" class="decide-again-btn" id="decideAgainBtn">Pick Another</button>
      </div>
    </div>
  </div>

  {(p.visibility?.timeline ?? true) && (
  <section class="timeline-wrap">
    <div class="timeline-scroll" id="timelineScroll">
      {CATEGORIES.map((cat: any, catIndex: number) => {
        const drinks = allDrinks.filter((d: any) => catSlug(d) === cat.tab);
        return (
          <div class="cat-group" data-cat={cat.tab}>
            <div class="cat-title-card" id={`cat-${cat.tab}`} data-cat={cat.tab}
              data-visible={cat.hiddenByDefault ? 'false' : undefined}
>
              <Editable blok={cat} />
              <div class="cat-title-inner">
                <h2 class="cat-title-text">{cat.title}</h2>
                <p class="cat-title-desc">{cat.desc}</p>
                <svg class="cat-arrow" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <line x1="4" y1="4" x2="28" y2="16" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                  <line x1="28" y1="16" x2="4" y2="28" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                </svg>
              </div>
            </div>
            <div class="cat-drinks-wrap">
            {drinks.map((drink: any) => (
              <a class={`drink-card${drink.slug === 'coldbrew-nitro-brew' ? ' nitro-card' : ''}`}
                data-cat={cat.tab} href={`/drinks/${drink.slug}`}
                data-visible={cat.hiddenByDefault ? 'false' : undefined}
>
                <Editable blok={drink} />
                {drink.badge && <span class="drink-badge">{drink.badge}</span>}
                <div class="drink-img-wrap">
                  {imageUrl(drink.image, { width: 480 }) && (
                    <img loading="lazy" decoding="async" src={imageUrl(drink.image, { width: 480 })} alt={drink.name} />
                  )}
                </div>
                <div class="drink-info">
                  <h3>{drink.name}</h3>
                  {drink.subtitle && <p>{drink.subtitle}</p>}
                </div>
              </a>
            ))}
            {cat.extraCards.map((card: any, cardIndex: number) => {
              const items: string[] = card.items ?? [];
              const isSodaCard = items.length > 6;
              const isTeaCard = /hot teas/i.test(card.label ?? '');
              const isWide = isSodaCard;
              return (
                <div class={`descriptor-card${isWide ? ' descriptor-card--wide' : ''}`} data-cat={cat.tab}
                  data-visible={cat.hiddenByDefault ? 'false' : undefined}
>
                  {/* Plain label + chip list -- the normal /menu view always
                      uses this (unchanged from before the simple-menu logo
                      treatment existed). Hidden via CSS in simple mode. */}
                  <div class="descriptor-plain-view">
                    <p class="descriptor-label">{card.label}</p>
                    <div class="descriptor-list">
                      {items.map((item: string) => <span>{item}</span>)}
                    </div>
                  </div>
                  {/* Logo/text row treatment -- only shown in simple mode
                      (see .menu-simple-mode .descriptor-simple-view in
                      menu.css); hardcoded rather than sourced from
                      card.items/card.label, see SODA_TOP_ROW etc. above. */}
                  {isSodaCard ? (
                    <div class="descriptor-simple-view descriptor-list descriptor-list--labeled">
                      <div class="descriptor-label-block">
                        <span class="descriptor-label-line">All Sodas</span>
                        <span class="descriptor-label-line">Available</span>
                      </div>
                      <div class="descriptor-logo-rows">
                        <div class="descriptor-row">
                          {SODA_TOP_ROW.map((soda) => (
                            <img class="descriptor-logo" src={soda.logo} alt={soda.name} loading="lazy" />
                          ))}
                        </div>
                        <div class="descriptor-row">
                          {SODA_BOTTOM_ROW.map((soda) => (
                            <img class="descriptor-logo" src={soda.logo} alt={soda.name} loading="lazy" />
                          ))}
                        </div>
                      </div>
                    </div>
                  ) : isTeaCard ? (
                    <div class="descriptor-simple-view descriptor-list descriptor-list--labeled">
                      <div class="descriptor-label-block">
                        <span class="descriptor-label-line">Hot Teas</span>
                        <span class="descriptor-label-line">Available</span>
                      </div>
                      <div class="descriptor-logo-rows">
                        <div class="descriptor-row descriptor-row--text">
                          {TEA_TOP_ROW.map((tea) => (
                            <span class="descriptor-text-chip">{tea}</span>
                          ))}
                        </div>
                        <div class="descriptor-row descriptor-row--text">
                          {TEA_BOTTOM_ROW.map((tea) => (
                            <span class="descriptor-text-chip">{tea}</span>
                          ))}
                        </div>
                      </div>
                    </div>
                  ) : null}
                </div>
              );
            })}
            </div>
          </div>
        );
      })}

      <div class="timeline-empty-state" id="timelineEmpty">
        <p>{p.labels?.emptyHeading ?? 'Nothing here yet.'}</p>
        <span>{p.labels?.emptySub ?? "But we're always working on something good."}</span>
      </div>
      <div class="timeline-end-spacer"></div>
    </div>
    <!--
      Mobile/simple-menu only: on a narrow viewport the timeline scrolls
      vertically and the customize-section (where the desktop "Help Me
      Decide" button lives, to the right of the flavor pills) can be a long
      scroll away, so give mobile visitors the same trigger right here,
      immediately after the last category. Hidden on desktop via menu.css.
    -->
    <div class="decide-btn-mobile-wrap">
      <button type="button" class="decide-btn decide-btn--mobile" id="helpMeDecideBtnMobile">
        Help Me Decide
      </button>
    </div>
  </section>
  )}

  <BlockRenderer sections={p.sections} />

  {(p.visibility?.customize ?? true) && (
  <section class="customize-section">
    <div class="cz-inner">
      <div class="cz-row">
        <div class="cz-heading">
          <h2>{p.customize?.heading ?? 'Sort by Flavor'}</h2>
          <p class="cz-filter-hint" id="czFilterHint" aria-live="polite"></p>
        </div>
        <div class="cz-block cz-flavor-block">
          <p class="cz-label">{p.customize?.flavorLabel ?? 'Tap to Filter the Menu'}</p>
          <div class="cz-pills cz-pills--flavors" id="czFlavorPills">
            {flavors.map(({ value: f, index: i }: any) => (
              <span class="cpill cpill--filter" data-flavor={f}>{f}</span>
            ))}
          </div>
        </div>
        <div class="cz-block cz-decide-block">
          <button type="button" class="decide-btn" id="helpMeDecideBtn">
            Help Me Decide
          </button>
        </div>
      </div>
    </div>
  </section>
  )}

  <Footer />

  <script define:vars={{ drinksJson, categoriesMetaJson, locationsMetaJson, decideDrinksJson, locationTriggerDefault: p.locationPicker?.triggerLabel ?? 'Select Your Location' }} is:inline>
    window.DRINKS = JSON.parse(drinksJson);
    window.CATEGORIES_META = JSON.parse(categoriesMetaJson);
    window.LOCATIONS_META = JSON.parse(locationsMetaJson);
    window.DECIDE_DRINKS = JSON.parse(decideDrinksJson);
    window.LOCATION_TRIGGER_DEFAULT = locationTriggerDefault;
  </script>
  <script is:inline>
  (function () {
    // ── "Help Me Decide" random drink popup ──
    // Reveal is two beats: the drinks scroll past like a carousel reel,
    // decelerating to a stop on the winner, then it's announced with a
    // spotlight bloom + sparkle burst.
    var drinks = window.DECIDE_DRINKS || [];
    var modal = document.getElementById('decideModal');
    var card = document.getElementById('decideCard');
    var imgWrap = document.getElementById('decideImgWrap');
    var track = document.getElementById('decideTrack');
    var nameEl = document.getElementById('decideName');
    var subtitleEl = document.getElementById('decideSubtitle');
    var sparkles = document.getElementById('decideSparkles');
    var closeBtn = document.getElementById('closeDecideModal');
    var againBtn = document.getElementById('decideAgainBtn');
    var openBtns = [document.getElementById('helpMeDecideBtn'), document.getElementById('helpMeDecideBtnMobile')];
    if (!modal || !drinks.length) return;

    var spinning = false;
    var spinToken = 0; // invalidates a still-running spin's transitionend if re-triggered

    // Warm the browser's image cache up front so the reel never stalls on a
    // network fetch mid-scroll -- every frame is already built into the
    // track before the animation starts (see play() below), so a cold
    // cache would otherwise show blank frames sliding past.
    drinks.forEach(function (d) { var pre = new Image(); pre.src = d.image; });

    function pickRandom(excludeSlug) {
      if (drinks.length < 2) return drinks[0];
      var d;
      do { d = drinks[Math.floor(Math.random() * drinks.length)]; } while (d.slug === excludeSlug);
      return d;
    }

    function renderSparkles() {
      sparkles.innerHTML = '';
      var n = 12;
      for (var i = 0; i < n; i++) {
        var s = document.createElement('span');
        s.className = 'decide-spark';
        var angle = (360 / n) * i + (Math.random() * 14 - 7);
        var dist = 74 + Math.random() * 42;
        s.style.setProperty('--a', angle + 'deg');
        s.style.setProperty('--d', dist + 'px');
        s.style.animationDelay = (Math.random() * 0.12) + 's';
        sparkles.appendChild(s);
      }
    }

    function frameEl(drink) {
      var frame = document.createElement('div');
      frame.className = 'decide-carousel-frame';
      var im = document.createElement('img');
      im.src = drink.image;
      im.alt = drink.name;
      frame.appendChild(im);
      return frame;
    }

    function play() {
      var token = ++spinToken;
      spinning = true;
      card.classList.remove('decide-landed');

      var frameCount = 20;
      var finalDrink = pickRandom();
      var lastSlug = null;
      var sequence = [];
      for (var i = 0; i < frameCount - 1; i++) {
        var d = pickRandom(lastSlug);
        lastSlug = d.slug;
        sequence.push(d);
      }
      sequence.push(finalDrink);

      track.style.transition = 'none';
      track.style.transform = 'translateX(0px)';
      track.innerHTML = '';
      sequence.forEach(function (d) { track.appendChild(frameEl(d)); });

      var frameWidth = imgWrap.getBoundingClientRect().width;
      var travel = frameWidth * (sequence.length - 1);

      // Force layout to flush before animating, so the reel visibly starts
      // at frame 0 instead of jumping straight to the end state.
      void track.offsetWidth;

      requestAnimationFrame(function () {
        if (token !== spinToken) return;
        // Long duration + a curve that front-loads deceleration: reads as a
        // heavy reel coasting to a natural stop, not a slot machine ticking.
        track.style.transition = 'transform 2.1s cubic-bezier(0.1, 0.7, 0.15, 1)';
        track.style.transform = 'translateX(-' + travel + 'px)';
      });

      function onSettled(e) {
        if (e && e.target !== track) return;
        track.removeEventListener('transitionend', onSettled);
        if (token !== spinToken) return;
        nameEl.textContent = finalDrink.name;
        subtitleEl.textContent = finalDrink.subtitle || '';
        card.classList.add('decide-landed');
        renderSparkles();
        spinning = false;
      }
      track.addEventListener('transitionend', onSettled);
    }

    function openModal() {
      modal.classList.add('active');
      play();
    }
    function closeModal() { modal.classList.remove('active'); }

    openBtns.forEach(function (btn) { if (btn) btn.addEventListener('click', openModal); });
    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', function (e) { if (e.target === modal) closeModal(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && modal.classList.contains('active')) closeModal(); });
    againBtn.addEventListener('click', function () { if (!spinning) play(); });
  })();
  </script>
  <script is:inline>
  (function () {
    var scroll = document.getElementById('timelineScroll');
    var catLinks = document.querySelectorAll('.cat-link');
    var titleCards = document.querySelectorAll('.cat-title-card');
    var descriptorCards = Array.from(scroll.querySelectorAll('.descriptor-card'));
    var drinkCards = Array.from(scroll.querySelectorAll('a.drink-card'));
    var timelineWrap = document.querySelector('.timeline-wrap');
    var filterHint = document.getElementById('czFilterHint');
    var emptyState = document.getElementById('timelineEmpty');

    // /menu/simple loads this same page in a full-width iframe with
    // ?simple=1 so it can reuse this exact markup/script for its compact,
    // small-card grid view instead of maintaining a second template --
    // see .menu-simple-mode in menu.css. isMobile() covers that case too,
    // so every branch below (autoscroll, equalizeCards, scroll direction,
    // wheel handling) treats it exactly like a real narrow viewport.
    var forceSimple = new URLSearchParams(window.location.search).get('simple') === '1';
    if (forceSimple) {
      document.body.classList.add('menu-simple-mode');
      // Loaded inside /menu/simple's iframe -- flip the trigger into a way
      // back to the real menu instead of a link to the page we're already
      // (functionally) showing. target="_parent" so it navigates the
      // top-level /menu/simple document out of the iframe, not the frame
      // itself back to a bare, un-wrapped /menu.
      var trigger = document.querySelector('.simple-menu-trigger');
      if (trigger) {
        trigger.href = '/menu';
        trigger.target = '_parent';
        var label = trigger.querySelector('span');
        if (label) label.textContent = 'Standard Menu';
      }
      // This whole page (Nav, Footer, everything) is rendered a second time
      // inside /menu/simple's iframe. Every real link on it -- nav items,
      // footer links, drink cards, gift card, etc -- would otherwise
      // navigate the iframe itself, leaving the top-level tab stuck on the
      // /menu/simple URL/title forever (and a refresh there reloads the
      // iframe back to this same page). Force every non-fragment link to
      // break out to the top-level document instead.
      document.querySelectorAll('a[href]').forEach(function (a) {
        var href = a.getAttribute('href');
        if (!href || href.charAt(0) === '#') return;
        a.target = '_parent';
      });
    }
    var mobileMq = window.matchMedia('(max-width: 768px)');
    function isMobile() { return forceSimple || mobileMq.matches; }

    function equalizeCards() {
      var cards = scroll.querySelectorAll('.drink-card');
      cards.forEach(function(c) { c.style.width = ''; c.style.minWidth = ''; });
      if (isMobile()) return; // mobile uses a CSS grid; don't force fixed widths
      var maxW = 0;
      cards.forEach(function(c) { if (c.offsetWidth > maxW) maxW = c.offsetWidth; });
      if (maxW > 0) cards.forEach(function(c) { c.style.width = maxW + 'px'; c.style.minWidth = maxW + 'px'; });
    }
    window.addEventListener('load', equalizeCards);
    window.addEventListener('resize', equalizeCards);

    // Keep the hero sized so navbar + hero + the timeline's first row
    // always add up to exactly one viewport (see .menu-hero's --timeline-h
    // usage in menu.css). Measured live since the timeline's height
    // depends on rendered category text, not just fixed image sizes.
    function syncHeroHeight() {
      if (isMobile()) return; // mobile hero sizes itself via aspect-ratio instead
      var h = timelineWrap.getBoundingClientRect().height;
      if (h > 0) document.documentElement.style.setProperty('--timeline-h', h + 'px');
    }
    window.addEventListener('load', syncHeroHeight);
    window.addEventListener('resize', syncHeroHeight);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(syncHeroHeight);
    syncHeroHeight();

    function getActiveCat() {
      var threshold = scroll.getBoundingClientRect().width * 0.35;
      var active = null;
      titleCards.forEach(function(card) {
        if (card.offsetParent === null) return; // hidden by a flavor/location filter
        var left = card.offsetLeft - scroll.scrollLeft;
        if (left <= threshold) active = card.dataset.cat;
      });
      if (active) return active;
      for (var i = 0; i < titleCards.length; i++) {
        if (titleCards[i].offsetParent !== null) return titleCards[i].dataset.cat;
      }
      return null;
    }
    function applyActiveCat(cat) {
      // While a flavor filter is active most category cards are hidden
      // (display:none), which breaks the "leftmost card" position heuristic
      // below, and a highlighted category doesn't mean anything in filter
      // view anyway, so just show none.
      if (activeFilter) {
        catLinks.forEach(function(btn) { btn.classList.remove('active'); });
        scroll.querySelectorAll('[data-cat]').forEach(function(el) { el.classList.remove('cat-active'); });
        return;
      }
      catLinks.forEach(function(btn) { btn.classList.toggle('active', btn.dataset.tab === cat); });
      scroll.querySelectorAll('[data-cat]').forEach(function(el) { el.classList.toggle('cat-active', el.dataset.cat === cat); });
    }
    scroll.addEventListener('scroll', function() { applyActiveCat(getActiveCat()); }, { passive: true });
    applyActiveCat('coffee');

    catLinks.forEach(function(btn) {
      btn.addEventListener('click', function() {
        stopAutoScroll();
        // A category is hidden by the current flavor filter, so clicking it
        // wouldn't visibly go anywhere. Clear the filter first so every
        // category (and this click) actually does something.
        if (activeFilter) clearFilter();
        var target = document.getElementById('cat-' + btn.dataset.tab);
        if (!target) return;
        if (isMobile()) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } else {
          scroll.scrollTo({ left: target.offsetLeft - 24, behavior: 'smooth' });
        }
        applyActiveCat(btn.dataset.tab);
      });
    });

    var rafId = null;
    var autoScrollStopped = false;
    var SCROLL_SPEED = 0.6;
    function autoScroll() {
      if (autoScrollStopped) return;
      scroll.scrollLeft += SCROLL_SPEED;
      rafId = requestAnimationFrame(autoScroll);
    }
    function stopAutoScroll() {
      autoScrollStopped = true;
      if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
    }
    ['wheel','mousedown','touchstart'].forEach(function(evt) { scroll.addEventListener(evt, stopAutoScroll, { once: true, passive: true }); });
    if (!isMobile()) rafId = requestAnimationFrame(autoScroll);
    setTimeout(function() { scroll.classList.add('timeline-ready'); }, 80);

    scroll.addEventListener('wheel', function(e) {
      if (isMobile()) return; // let the page scroll vertically on mobile
      if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) { e.preventDefault(); scroll.scrollLeft += e.deltaY * 3; }
    }, { passive: false });

    // On mobile the timeline scrolls vertically, so highlight the category
    // whose header is currently in view.
    if (isMobile() && 'IntersectionObserver' in window) {
      var catObserver = new IntersectionObserver(function(entries) {
        entries.forEach(function(e) { if (e.isIntersecting) applyActiveCat(e.target.dataset.cat); });
      }, { rootMargin: '-45% 0px -50% 0px' });
      titleCards.forEach(function(c) { catObserver.observe(c); });
    }

    var paramTab = (window.location.hash || '').replace(/^#/, '') || new URLSearchParams(window.location.search).get('tab');
    if (paramTab && document.getElementById('cat-' + paramTab)) {
      window.addEventListener('load', function() {
        stopAutoScroll(); equalizeCards();
        var target = document.getElementById('cat-' + paramTab);
        if (isMobile()) {
          target.scrollIntoView({ behavior: 'instant', block: 'start' });
        } else {
          scroll.scrollTo({ left: target.offsetLeft - 24, behavior: 'instant' });
        }
        applyActiveCat(paramTab);
      });
    }

    function animateOut(el) {
      el.classList.remove('filter-animating-in'); el.classList.add('filter-animating-out');
      setTimeout(function() { el.classList.remove('filter-animating-out'); el.style.display = 'none'; }, 180);
    }
    function animateIn(el, delay) {
      el.style.display = ''; el.classList.remove('filter-animating-out','filter-animating-in');
      void el.offsetWidth; el.style.animationDelay = (delay || 0) + 'ms';
      el.classList.add('filter-animating-in');
      el.addEventListener('animationend', function() { el.classList.remove('filter-animating-in'); el.style.animationDelay = ''; }, { once: true });
    }
    // Only actually animates elements whose visibility changed since the
    // last refresh, otherwise every store/flavor change would re-trigger
    // the entrance animation on cards that were already showing.
    // data-visible is the single source of truth for whether an element is
    // shown. Both the CSS default-hide rule and this change-tracking key
    // off it, so an element only re-animates when it actually flips state.
    // Absent = visible (matches everything that isn't hidden-by-default).
    function setVisible(el, visible, delay) {
      var was = el.dataset.visible !== 'false';
      el.dataset.visible = visible ? 'true' : 'false';
      if (was === visible) return false;
      if (visible) animateIn(el, delay || 0); else animateOut(el);
      return true;
    }

    // ── Combined flavor + location filtering ──
    var activeFilter = null;   // flavor string, or null
    var selectedStore = null;  // location slug, or null (= no location picked)

    function categoryVisible(tab) {
      var meta = CATEGORIES_META[tab];
      if (!meta) return true;
      // hiddenByDefault is an absolute "nothing is in this section right now"
      // switch -- it must win even after a location is picked, otherwise
      // picking a store re-reveals a category (e.g. an empty seasonal
      // lineup) that unavailableAt was never asked to hide per-location.
      if (meta.hiddenByDefault) return false;
      if (!selectedStore) return true;
      return meta.unavailableAt.indexOf(selectedStore) === -1;
    }
    function drinkVisible(slug) {
      var d = DRINKS[slug];
      if (!d) return false;
      if (!categoryVisible(d.catSlug)) return false;
      if (selectedStore && d.unavailableAt.indexOf(selectedStore) !== -1) return false;
      if (activeFilter && (!d.tags || d.tags.indexOf(activeFilter) === -1)) return false;
      return true;
    }
    function drinkSlug(card) { return (card.getAttribute('href') || '').replace('/drinks/', ''); }

    function refresh() {
      var filtering = !!activeFilter || !!selectedStore;

      if (!isMobile()) {
        if (timelineWrap) timelineWrap.style.minHeight = timelineWrap.offsetHeight + 'px';
        scroll.style.minHeight = scroll.offsetHeight + 'px';
      }
      scroll.classList.toggle('has-filter', filtering);
      if (activeFilter) {
        catLinks.forEach(function(btn) { btn.classList.remove('active'); });
        scroll.querySelectorAll('[data-cat]').forEach(function(el) { el.classList.remove('cat-active'); });
      }

      catLinks.forEach(function(btn) {
        // The [data-visible="false"] CSS rule is what actually hides this
        // (same mechanism as setVisible). A plain style.display toggle
        // would be overridden by that rule the moment it's cleared, since
        // clearing an inline style just falls back to the stylesheet.
        btn.dataset.visible = categoryVisible(btn.dataset.tab) ? 'true' : 'false';
      });

      var visibleCatSet = {};
      drinkCards.forEach(function(card) {
        var d = DRINKS[drinkSlug(card)];
        if (d && drinkVisible(drinkSlug(card))) visibleCatSet[d.catSlug] = true;
      });

      descriptorCards.forEach(function(c) {
        setVisible(c, categoryVisible(c.dataset.cat) && !activeFilter, 0);
      });

      var mi = 0;
      titleCards.forEach(function(card) {
        var tab = card.dataset.cat;
        var visible = categoryVisible(tab) && (!activeFilter || visibleCatSet[tab]);
        if (setVisible(card, visible, mi * 30) && visible) mi++;
      });

      var mi2 = 0, totalVisible = 0;
      drinkCards.forEach(function(card) {
        var visible = drinkVisible(drinkSlug(card));
        if (visible) totalVisible++;
        if (setVisible(card, visible, mi2 * 18) && visible) mi2++;
      });

      if (emptyState) emptyState.classList.toggle('visible', filtering && totalVisible === 0);
      if (filterHint) filterHint.textContent = activeFilter ? ('Showing drinks with: ' + activeFilter + ' - tap again to clear') : '';

      if (!isMobile()) {
        setTimeout(function() { if (timelineWrap) timelineWrap.style.minHeight = ''; scroll.style.minHeight = ''; }, 600);
      }
    }

    function clearFilter() {
      activeFilter = null;
      document.querySelectorAll('.cpill--filter').forEach(function(p) { p.classList.remove('cpill--active'); });
      refresh();
    }

    document.querySelectorAll('.cpill--filter').forEach(function(pill) {
      pill.addEventListener('click', function() {
        var flavor = pill.dataset.flavor;
        if (activeFilter === flavor) { clearFilter(); }
        else {
          activeFilter = flavor;
          document.querySelectorAll('.cpill--filter').forEach(function(p) { p.classList.remove('cpill--active'); });
          document.querySelectorAll('.cpill--filter[data-flavor="' + flavor + '"]').forEach(function(p) { p.classList.add('cpill--active'); });
          refresh();
          document.querySelector('.timeline-wrap').scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });

    // ── "Select Your Location" popup ──
    var LOCATION_KEY = '151_selected_location';
    var locationModal = document.getElementById('locationModal');
    var locationTrigger = document.getElementById('locationTrigger');
    var locationTriggerLabel = document.getElementById('locationTriggerLabel');
    var closeLocationModal = document.getElementById('closeLocationModal');

    function updateTriggerUI() {
      var loc = selectedStore && LOCATIONS_META[selectedStore];
      locationTriggerLabel.textContent = loc ? loc.shortName : (window.LOCATION_TRIGGER_DEFAULT || 'Select Your Location');
      locationTrigger.classList.toggle('has-location', !!loc);
      document.querySelectorAll('.loc-modal-item').forEach(function(btn) {
        btn.classList.toggle('active', (btn.dataset.store || '') === (selectedStore || ''));
      });
    }
    function openLocationModal() { locationModal.classList.add('active'); }
    function closeModal() { locationModal.classList.remove('active'); }

    function selectStore(slug) {
      selectedStore = (slug && LOCATIONS_META[slug]) ? slug : null;
      try {
        if (selectedStore) localStorage.setItem(LOCATION_KEY, selectedStore);
        else localStorage.removeItem(LOCATION_KEY);
      } catch (e) {}
      updateTriggerUI();
      refresh();
      closeModal();
    }

    locationTrigger.addEventListener('click', openLocationModal);
    closeLocationModal.addEventListener('click', closeModal);
    locationModal.addEventListener('click', function(e) { if (e.target === locationModal) closeModal(); });
    document.querySelectorAll('.loc-modal-item').forEach(function(btn) {
      btn.addEventListener('click', function() { selectStore(btn.dataset.store); });
    });

    // A location's "See This Store's Menu" button links here with
    // ?store=<slug>. Honor that over anything already saved.
    var queryStore = new URLSearchParams(window.location.search).get('store');
    var storedStore = null;
    try { storedStore = localStorage.getItem(LOCATION_KEY); } catch (e) {}

    if (queryStore && LOCATIONS_META[queryStore]) {
      selectStore(queryStore);
    } else if (storedStore && LOCATIONS_META[storedStore]) {
      selectedStore = storedStore;
      updateTriggerUI();
      refresh();
    } else {
      // First visit (no saved preference): invite them to pick a location.
      setTimeout(openLocationModal, 700);
    }
  })();
  </script>

