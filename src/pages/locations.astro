---
export const prerender = import.meta.env.STORYBLOK_DRAFT_MODE !== 'true';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import BlockRenderer from '../components/blocks/BlockRenderer.astro';
import { getLocations, getSettings, getPage, unwrapSingletons, imageUrl } from '../lib/storyblok';
import Editable from '../components/Editable.astro';
import JsonLd from '../components/JsonLd.astro';
import { graph, locationSchema, breadcrumbSchema } from '../lib/seo';

const toImageSrc = (field: any) => {
  const url = imageUrl(field, { width: 300 });
  return url ? (url.startsWith('http') || url.startsWith('/') ? url : '/' + url) : undefined;
};

const [locationsEntries, settingsData, pageData] = await Promise.all([
  getLocations(),
  getSettings(),
  getPage('locations'),
]);

const s = (settingsData as any) ?? {};
const p = unwrapSingletons((pageData as any) ?? {}, ['seo', 'visibility', 'hero', 'storeDetail']);
const locations = locationsEntries
  .sort((a: any, b: any) => (Number(a.displayOrder) || 99) - (Number(b.displayOrder) || 99));

const storesJson = JSON.stringify(locations.map((l: any) => ({
  name: l.name, address: l.address, city: l.city, state: l.state, zip: l.zip, lat: Number(l.lat), lng: Number(l.lng),
  // Only this page's locator needs these. Their presence is what tells
  // locator.js to render a photo + "More Info" link on each list item.
  slug: l.slug,
  image: toImageSrc(l.image),
})));

// Group locations by state for the cards grid
const byState: Record<string, typeof locations> = {};
for (const loc of locations) {
  const key = loc.state ?? 'Other';
  if (!byState[key]) byState[key] = [];
  byState[key].push(loc);
}
const STATE_NAMES: Record<string, string> = Object.fromEntries(
  (p.stateNames ?? [{ code: 'TX', name: 'Texas' }, { code: 'KS', name: 'Kansas' }])
    .filter((s: any) => s?.code)
    .map((s: any) => [s.code, s.name])
);

// The store index is the natural ItemList of every location, in the same
// display order the page renders. Each entry is a full CafeOrCoffeeShop node
// keyed by @id, so it reinforces rather than duplicates the individual store
// pages' own markup.
const locationsJsonLd = graph(
  {
    '@type': 'ItemList',
    name: p.seo?.title ?? '151 Coffee Locations',
    numberOfItems: locations.length,
    itemListElement: locations.map((loc: any, i: number) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: locationSchema(loc, s),
    })),
  },
  breadcrumbSchema([{ name: 'Home', url: '/' }, { name: 'Locations' }]),
);
---
<Layout
  title={p.seo?.title ?? '151 Coffee Locations | Find a Drive-Thru Near You'}
  description={p.seo?.description ?? 'Find your nearest 151 Coffee drive-thru. 15+ locations across Texas and Kansas with more opening soon.'}
  ogImage={imageUrl(p.seo?.ogImage, { width: 1200, height: 630 })}

>
  <fragment slot="head">
    <link rel="preconnect" href="https://unpkg.com" crossorigin />
    <!-- The map fills the entire initial viewport on this page (it's never
         actually offscreen for locator-loader.js's IntersectionObserver to
         defer), so starting these fetches immediately -- in parallel with
         HTML parsing, instead of waiting on JS to inject them -- shaves a
         full request's worth of latency off when the map becomes usable. -->
    <link rel="preload" as="style" href="https://unpkg.com/maplibre-gl@5.6.1/dist/maplibre-gl.css" crossorigin />
    <link rel="preload" as="script" href="https://unpkg.com/maplibre-gl@5.6.1/dist/maplibre-gl.js" crossorigin />
    <link rel="preload" as="script" href="/js/maplibre-map-helpers.js?v=1" />
    <!-- The vector basemap style and its tiles come from CARTO, so the
         connection to that origin is worth opening before the map asks. -->
    <link rel="preconnect" href="https://basemaps.cartocdn.com" crossorigin />
    <link rel="preload" as="script" href="/js/locator.js" />
    <JsonLd schema={locationsJsonLd} />
  </fragment>

  <Nav active="locations" />

  <BlockRenderer sections={p.sections} />

  {(p.visibility?.map ?? true) && (
  <section class="loc-fullpage" data-loc-fullpage>
    <div class="locator locator--full">
      <div class="locator__panel">
        <div class="locator__panel-header">
          <Editable blok={p} />
          <h1>{p.hero?.heading ?? 'Find Your 151'}</h1>
          <span class="loc-count-inline">
            <strong>{locations.length}</strong> {p.hero?.countSuffix ?? 'Locations Open'}
          </span>
        </div>
        <div class="locator__search">
          <input type="text" id="locator-search" aria-label="Search locations" placeholder={p.searchPlaceholder ?? 'Search by city, state, or zip...'} />
        </div>
        <div class="locator__state-filters">
          <button type="button" class="locator__state-btn active" data-state-filter="TX">Texas</button>
          <button type="button" class="locator__state-btn" data-state-filter="KS">Kansas</button>
        </div>
        <div class="locator__list" id="locator-list"></div>
      </div>
      <div class="locator__map-wrap">
        <div class="locator__zoom">
          <button type="button" id="locator-zoom-out" aria-label="Zoom out">&#8722;</button>
          <button type="button" id="locator-zoom-in" aria-label="Zoom in">&#43;</button>
        </div>
        <div class="locator__map" id="locator-map"></div>
        <span class="loc-count-wrap">
          <span class="loc-count-number">{locations.length}</span>
          <span class="loc-count loc-count--badge">
            <span class="loc-count-label">{p.hero?.countSuffix ?? 'Locations Open'}</span>
          </span>
        </span>
      </div>
    </div>
  </section>
  )}

  <!-- Every location as plain crawlable links, grouped by state -- the
       sidebar list above is populated client-side by locator.js, so this is
       what keeps every store page reachable without JS and gives crawlers a
       real link per location (on top of the ItemList JSON-LD below). Visually
       out of the way since the locator above is the real UI. -->
  <!-- On desktop/tablet the locator above IS the whole page (no scroll at
       all); this tail only ever appears in the narrow-screen fallback layout,
       where the page scrolls normally anyway, so the sitemap links and
       footer are hidden rather than removed above ~640px. -->
  <div class="loc-page-tail">
    <div class="loc-sitemap" role="navigation" aria-label="All locations">
      <div class="container">
        {Object.entries(byState).map(([stateCode, locs]) => (
          <div class="loc-sitemap__group">
            <span class="loc-sitemap__state">{STATE_NAMES[stateCode] ?? stateCode}</span>
            {locs.map((loc: any) => (
              <a href={`/locations/${loc.slug}`}>{loc.city}, {loc.state}</a>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Rendered outside .loc-page-tail (which is display:none) - the gift
       card modal it contains must stay reachable from the nav button even
       though the sitemap tail itself is hidden. -->
  <Footer />

  <script define:vars={{ storesJson, hours: s.hours, phone: s.phone }} is:inline>
    window.COFFEE151_STORES = JSON.parse(storesJson);
    window.COFFEE151_LOCATOR = { hours, phone };
  </script>
  <script src="/js/locator-loader.js" is:inline></script>
</Layout>
