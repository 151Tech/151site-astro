---
export const prerender = import.meta.env.STORYBLOK_DRAFT_MODE !== 'true';
import { getDrinks, getCategories } from '../../lib/storyblok';
import { routableItems, itemPath } from '../../lib/menu-urls.mjs';

// Old /drinks/<slug> URLs permanently redirect to /menu/<category>/<item>.
// Unknown slugs 404.
export async function getStaticPaths() {
  const [drinks, categories] = await Promise.all([getDrinks(), getCategories()]);
  return routableItems(drinks, categories).map((d: any) => ({ params: { slug: d.slug } }));
}

const { slug } = Astro.params;
const [drinks, categories] = await Promise.all([getDrinks(), getCategories()]);
const drink = routableItems(drinks, categories).find((d: any) => d.slug === slug);
if (!drink) return Astro.rewrite('/404');
return Astro.redirect(itemPath(drink), 301);
---
