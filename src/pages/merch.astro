---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getPage, unwrapSingletons, imageUrl } from '../lib/storyblok';
import Editable from '../components/Editable.astro';

const p = unwrapSingletons((await getPage('merch')) as any, ['seo', 'visibility', 'hero']);

const categories = ['All', ...Array.from(new Set((p.items ?? []).map((i: any) => i.category))) as string[]];
---
<Layout title={p.seo?.title ?? '151 Coffee Merch | Rep Your Favorite Coffee'} description={p.seo?.description} ogImage={imageUrl(p.seo?.ogImage)}>
  <Nav />

  <section class="page-hero">
    <div class="page-hero-overlay"></div>
    <div class="container">
      <div class="page-hero-content">
        <Editable blok={p} />
        <h1>{p.hero?.heading}</h1>
        <p>{p.hero?.subheading}</p>
      </div>
    </div>
  </section>

  {(p.visibility?.products ?? true) && (
  <section class="merch-section">
    <div class="container">
      <div class="merch-filters">
        {categories.map(cat => (
          <button class={`filter-pill${cat === 'All' ? ' active' : ''}`} data-category={cat}>{cat}</button>
        ))}
      </div>
      <div class="merch-grid">
        {(p.items ?? []).map((item: any, i: number) => (
          <div class="merch-card" data-category={item.category}>
            <Editable blok={item} />
            <div class="merch-img-wrap">
              {imageUrl(item.image)
                ? <img src={imageUrl(item.image)} alt={item.name} loading="lazy" />
                : <div class="merch-placeholder"></div>
              }
            </div>
            <div class="merch-info">
              <h3>{item.name}</h3>
              <span class="merch-price">{item.price}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
  )}

  <Footer />

  <script is:inline>
    document.querySelectorAll('.filter-pill').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var cat = this.getAttribute('data-category');
        document.querySelectorAll('.filter-pill').forEach(function(b) { b.classList.remove('active'); });
        this.classList.add('active');
        document.querySelectorAll('.merch-card').forEach(function(card) {
          card.style.display = (cat === 'All' || card.getAttribute('data-category') === cat) ? '' : 'none';
        });
      });
    });
  </script>
</Layout>
