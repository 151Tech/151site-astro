---
export const prerender = import.meta.env.STORYBLOK_DRAFT_MODE !== 'true';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getPage, unwrapSingletons, imageUrl } from '../lib/storyblok';
import Editable from '../components/Editable.astro';

const p = unwrapSingletons((await getPage('privacy')) as any, ['seo', 'hero']);
const sections: any[] = p.sections ?? [];
---
<Layout title={p.seo?.title ?? 'Privacy Policy | 151 Coffee'} description={p.seo?.description ?? '151 Coffee privacy policy - how we collect, use, and protect your information.'} ogImage={imageUrl(p.seo?.ogImage, { width: 1200, height: 630 })}>
  <Nav />

  <section class="page-hero page-hero--short">
    <div class="container">
      <div class="page-hero-content">
        <Editable blok={p} />
        <h1>{p.hero?.heading ?? 'Privacy Policy'}</h1>
        <p>{p.hero?.subheading ?? 'Last updated: June 2025'}</p>
      </div>
    </div>
  </section>

  <section class="legal-content">
    <div class="container legal-container">
      {sections.map((sec: any, i: number) => (
        <div>
          <Editable blok={sec} />
          <h2>{sec.heading}</h2>
          <p>{sec.body}</p>
        </div>
      ))}
    </div>
  </section>

  <Footer />
</Layout>
