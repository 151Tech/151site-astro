---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getPage, unwrapSingletons, imageUrl } from '../lib/storyblok';

const p = unwrapSingletons((await getPage('privacy')) as any, ['seo', 'hero']);
const sections: any[] = p.sections ?? [];
---
<Layout title={p.seo?.title ?? 'Privacy Policy | 151 Coffee'} description={p.seo?.description ?? '151 Coffee privacy policy - how we collect, use, and protect your information.'} ogImage={imageUrl(p.seo?.ogImage)}>
  <Nav />

  <section class="page-hero" style="min-height:30vh;">
    <div class="page-hero-overlay"></div>
    <div class="container">
      <div class="page-hero-content">
        <h1>{p.hero?.heading ?? 'Privacy Policy'}</h1>
        <p>{p.hero?.subheading ?? 'Last updated: June 2025'}</p>
      </div>
    </div>
  </section>

  <section class="legal-content">
    <div class="container" style="max-width:800px;padding:4rem 1rem;">
      {sections.map((sec: any, i: number) => (
        <div>
          <h2>{sec.heading}</h2>
          <p>{sec.body}</p>
        </div>
      ))}
    </div>
  </section>

  <Footer />
</Layout>
